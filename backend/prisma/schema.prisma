// ============================================================================
// UNIFIED SCHEMA
// Merges: web app schema (AI-assisted verification pipeline) +
//         mobile app schema (marketplace booking/quote/escrow/payment engine)
// See accompanying notes for merge decisions and open questions.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URLs now live in prisma.config.ts (Prisma ORM 7+)
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  CLIENT
  WORKER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  QUOTE_SUBMITTED
  QUOTE_APPROVED
  DISPUTED
  PENDING_COMPLETION
  // Client confirmed the work is done but payment (GCash/Maya) has not yet
  // cleared. The Xendit invoice for the full final total exists; the
  // invoice-paid webhook moves this to COMPLETED. CASH bookings skip this
  // state entirely (they go straight to COMPLETED on confirmation).
  AWAITING_PAYMENT
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  SUBMITTED
  APPROVED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

// Vestigial since the move to pay-after-completion (no funds are ever held by
// the platform). Kept for backward compatibility and admin reporting:
//   HELD     = payment not yet settled
//   RELEASED = payment collected and the worker's side settled (payout created
//              or, for cash, commission/tax debt accrued)
//   REFUNDED = payment refunded
enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

enum PayoutStatus {
  PENDING // Payout row created, not yet sent to Xendit
  PROCESSING // Xendit disbursement created, awaiting webhook confirmation
  PAID // Xendit confirmed the payout succeeded
  FAILED // Xendit confirmed failure, or a platform-side error before send
}

enum PaymentMethodType {
  GCASH
  MAYA
  CASH
}

enum KYCStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum KycDocumentType {
  GOVERNMENT_ID_FRONT
  GOVERNMENT_ID_BACK
  SELFIE
  RESUME
  CERTIFICATION
  NBI_CLEARANCE
  BARANGAY_CLEARANCE
  POLICE_CLEARANCE
  CEDULA
}

enum KycDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContractType {
  WORKER_SERVICE_AGREEMENT
  CLIENT_USER_AGREEMENT
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  PAYMENT_REFUNDED
  ADDON_ADDED
  REVIEW_RECEIVED
  MESSAGE_RECEIVED
  VERIFICATION_EMAIL
  PASSWORD_RESET
  QUOTE_SUBMITTED
  QUOTE_APPROVED
  QUOTE_DISPUTED
  QUOTE_REMINDER
  QUOTE_AUTO_APPROVED
  COMPLETION_REMINDER
  PAYMENT_REMINDER
  BOOKING_AUTO_COMPLETED
  VERIFICATION_SUBMITTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  PAYOUT_SENT
  PAYOUT_FAILED
  ACCOUNT_ON_HOLD
  ACCOUNT_HOLD_RELEASED
  VAT_REGISTRATION_APPROVED
  VAT_REGISTRATION_REJECTED
  BOOKING_RESCHEDULED
  BOOKING_RESCHEDULE_ESCALATED
  BOOKING_RESCHEDULE_REMINDER
  BOOKING_RESCHEDULE_CONFIRMED
  BOOKING_RESCHEDULE_REQUESTED
  BOOKING_RESCHEDULE_REQUEST_ACCEPTED
  BOOKING_RESCHEDULE_REQUEST_DECLINED
  BOOKING_ARRIVAL_FLAGGED
  REFUND_FAILED
  PAYOUT_METHOD_CHANGED
  PAYOUT_NAME_MISMATCH
  TAX_RECORDS_NEED_REVIEW
  VAT_THRESHOLD_CROSSED
  WORKER_NO_SHOW_FLAGGED
  DISPUTE_STALE_REMINDER
  KYC_REVERIFICATION_REQUIRED
  ACCOUNT_AUTO_SUSPENDED
  REVIEW_RESPONSE_ADDED
  CERTIFICATION_APPROVED
  CERTIFICATION_REJECTED
  DISPUTE_OPENED
  DISPUTE_RESOLVED
  MESSAGE_REPORTED
  CERTIFICATION_NEEDS_DETAILS
  // Distinct from CERTIFICATION_APPROVED/REJECTED — sent when approving/
  // rejecting the gating Certification also unlocks/declines a whole
  // WorkerServiceCategory (see adminCertificationController's side effect).
  // The meaningful event for a worker here is booking eligibility, not just
  // document status, so it's a separate, additional notification.
  SERVICE_CATEGORY_VERIFIED
  SERVICE_CATEGORY_REJECTED
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum UrgencyLevel {
  STANDARD
  URGENT
  EMERGENCY
}

enum RoomType {
  BEDROOM
  BATHROOM
  KITCHEN
  LIVING_ROOM
  DINING_ROOM
  OFFICE
  GARAGE
  BALCONY
  OTHER
}

enum ConditionType {
  TIDY
  NORMAL
  HEAVY
}

enum ScopeFieldType {
  TEXT
  SELECT
  MULTI_SELECT
  NUMBER
}

// FIXED: one admin-bounded price, worker sets a single number.
// PER_UNIT: worker sets a rate; final price = rate x the answer to
// ServiceTask.quantityScopeField (e.g. per-kilo laundry, per-sqm painting).
// CUSTOM_QUOTE: no upfront price at all — worker quotes after inspecting,
// via the existing submitQuote flow (see bookingController.submitQuote).
enum TaskPricingModel {
  FIXED
  PER_UNIT
  // Worker-defined price steps against the same quantity field PER_UNIT
  // uses (e.g. "up to 10 sqm -> P1000, up to 20 sqm -> P2100") — see
  // WorkerTaskTierPrice. Admin config is identical to PER_UNIT (one
  // quantityScopeFieldId + one minPrice/maxPrice bound); only the worker's
  // own WorkerTaskTierPrice rows differ from a PER_UNIT worker's single rate.
  TIERED
  CUSTOM_QUOTE
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  phone    String?
  password String
  fullName String
  role     Role

  isVerified              Boolean @default(false) // basic email/phone verification, not KYC
  avatar                  String?
  notificationPreferences Json?
  // Expo push token for the device the user most recently logged in on —
  // single-device by design (matches the mobile client's single in-memory
  // token model). Overwritten on each login/registration; cleared on logout.
  pushToken               String?

  // Admin MFA (TOTP, RFC 6238) — enforced (not merely offered) for ADMIN-role
  // accounts; see authController.login. False until verify-setup succeeds;
  // the secret/backup codes themselves live in MfaSecret/MfaBackupCode so a
  // half-finished setup never flips this true. Irrelevant for CLIENT/WORKER.
  mfaEnabled Boolean @default(false)

  // Soft delete — isDeleted/deletedAt is the single gate used everywhere to
  // exclude a user from active queries. `status` records *why* — self-deleted,
  // admin-suspended, or admin-banned — so those cases stay distinguishable.
  isDeleted Boolean    @default(false)
  deletedAt DateTime?
  status    UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile        ClientProfile?
  workerProfile        WorkerProfile?
  addresses            UserAddress[]
  sentMessages         Message[]             @relation("sender")
  receivedMessages     Message[]             @relation("receiver")
  bookingsAsClient     Booking[]             @relation("client")
  bookingsAsWorker     Booking[]             @relation("worker")
  reviews              Review[]
  notifications        Notification[]
  authTokens           AuthToken[]
  verificationRequests VerificationRequest[]
  contractAcceptances  ContractAcceptance[]
  mfaSecret            MfaSecret?
  mfaBackupCodes       MfaBackupCode[]

  @@index([email])
  @@index([role])
  @@index([isDeleted])
  @@index([status])
  // Admin Users/Workers list endpoints filter on role+isDeleted together and
  // always sort by createdAt desc — covers both the filter and the sort.
  @@index([role, isDeleted, createdAt])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

model UserAddress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label   String?
  // House/unit/building number and barangay are split out from `street` so
  // the geocoder can be given a structured query (street+barangay+city vs. one
  // free-text blob) — Nominatim resolves PH addresses far more precisely with
  // the barangay present, and house number lets a future routing/geocoding
  // provider pin the exact lot rather than just the street.
  houseNumber String?
  street      String
  barangay    String?
  city        String
  state       String?
  zipCode     String?
  // Free-text landmark ("beside Mercury Drug") — not geocoded itself, but
  // shown to the worker so they can confirm they're at the right gate/unit.
  landmark  String?
  isDefault Boolean @default(false)

  // Resolved coordinates, persisted server-side (previously cached only in
  // on-device AsyncStorage, which meant a reinstall or new device silently
  // lost them and forced a re-geocode). `geocodeAccuracy` is the device GPS
  // accuracy radius in meters when resolved via "Use my location" (null when
  // resolved by geocoding typed text, which carries no accuracy figure).
  lat             Float?
  lng             Float?
  geocodeAccuracy Float?
  geocodedAt      DateTime?

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// One row per user (currently only ever created for ADMIN accounts, but not
// DB-enforced — the role gate lives in authController). `secretEncrypted` is
// AES-256-GCM ciphertext (see utils/encryption.ts), never the raw TOTP
// secret. `pending` is true from POST /auth/mfa/setup until
// POST /auth/mfa/verify-setup confirms the first code, so a secret that was
// generated but never confirmed can never be used to pass a login
// challenge or back User.mfaEnabled=true.
model MfaSecret {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  secretEncrypted String
  pending         Boolean @default(true)

  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  confirmedAt DateTime?

  @@index([userId])
}

// Ten single-use recovery codes minted alongside a confirmed MfaSecret.
// `codeHash` uses the same bcrypt helper as User.password (utils/passwordHash)
// — codes are shown once in the verify-setup response and never stored or
// retrievable in plaintext again.
model MfaBackupCode {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  codeHash String
  used     Boolean   @default(false)
  usedAt   DateTime?

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([userId, used])
}

// ============================================================================
// PROFILES
// ============================================================================

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  address String?
  city    String?
  state   String?
  zipCode String?

  // Payment hold — mirrors WorkerProfile.commissionOwed/debtHoldAt/
  // debtHoldNote (same shape, opposite party). Set by
  // adminDisputeController.resolveDispute's RESOLVE_FOR_WORKER action: the
  // client confirmed a job (so the worker's labor is real and done) but the
  // 72h auto-escalation dispute got resolved without payment ever landing.
  // Blocks new bookings (see bookingController.createBooking) until an
  // admin clears it — either the client pays (the existing AWAITING_PAYMENT
  // invoice-paid webhook path clears it automatically, see
  // finalizePaidBooking) or an admin releases it manually. Left in place
  // (not auto-cleared) even after PAY_WORKER_FROM_PLATFORM, since the
  // platform then owns the collection problem instead of the worker.
  outstandingBalance Float     @default(0)
  paymentHoldAt      DateTime?
  paymentHoldNote    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  paymentMethods SavedPaymentMethod[]

  @@index([userId])
  @@index([paymentHoldAt])
}

model WorkerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio          String?
  rating       Float   @default(5.0)
  totalReviews Int     @default(0)

  // Digital ID card fields — shown to clients in person (digital-id.tsx).
  // Distinct from serviceAreaRadius (a booking-matching radius in km) and
  // ResumeParseResult.tradeCategory (AI-extracted, not worker-edited).
  digitalIdTrade       String?
  digitalIdServiceArea String?
  licenseNumber        String?

  // Availability & Capacity
  isAvailable       Boolean @default(true)
  maxConcurrentJobs Int     @default(2)
  activeJobCount    Int     @default(0)
  availableDays     Int[]   @default([1, 2, 3, 4, 5]) // 0=Sun, 1=Mon ... 6=Sat
  serviceAreaRadius Int     @default(30) // in kilometers

  // Set when the worker hits AppSettings.maxDeclinesBeforeCooldown declines
  // within the rolling declineWindowHours — excluded from auto-match
  // candidates (see matchingService.findAutoMatchWorker) until this passes.
  declineCooldownUntil DateTime?

  // Job preferences — used by auto-matching to filter candidate workers.
  // Specific-skill filtering (e.g. "does this worker service air
  // conditioners specifically") lives on WorkerScopeFieldCapability instead —
  // see that model's docblock.
  acceptsPets Boolean @default(false)

  // Location
  address String?
  city    String?
  state   String?
  zipCode String?

  // Geocoded from address/city/state/zipCode when the worker saves their
  // profile (see workerController.updateWorkerProfile) — the worker's fixed
  // service base, used to compute the distance-based pricing fee at booking
  // time (see bookingController.createBooking). Bookings are scheduled in
  // advance, not dispatched to a live position, so this is a static "shipping
  // fee" style distance rather than real-time proximity.
  addressLat Float?
  addressLng Float?

  // Live position while the worker is en route to an ACCEPTED booking, pushed
  // from the worker app's foreground GPS watch and read by the client's
  // "Track Service" map in real time over the existing Socket.IO channel (see
  // bookingController.updateWorkerLiveLocation). This is NOT the old
  // proximity/auto-matching feature that once lived on these same columns
  // (see matchingService.ts's docblock) and was removed for being unreliable
  // — that feature used a stale position to *choose* a worker; this one only
  // streams a live position for an *already-booked* job the client is
  // actively watching, and stops as soon as the worker checks in as arrived.
  // Distinct from Booking.workerLat/workerLng, which is a one-time arrival
  // snapshot written by arriveBooking, not a continuously updated live feed.
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?

  // KYC — denormalized snapshot; source of truth is VerificationRequest
  kycStatus      KYCStatus @default(PENDING)
  kycSubmittedAt DateTime?
  kycApprovedAt  DateTime?

  // Resume file URL (raw file)
  resumeUrl String?

  // Payout destination for withdrawing earnings (worker-configured)
  payoutMethod        PaymentMethodType?
  payoutAccountName   String?
  payoutAccountNumber String?

  // BIR Tax Identification Number — required before a Form 2307 withholding
  // certificate can be generated for this worker (see taxCertificateService).
  // Format: 000-000-000 or 000-000-000-000 with branch code (see utils/taxId.ts).
  tin           String?   @unique
  tinVerifiedAt DateTime?

  // VAT registration — self-declared then admin-verified (mirrors the
  // Certification review pattern, not the KYC AI pipeline: one document, one
  // reviewer decision). vatRegistered is the ONLY field pricing/booking logic
  // may read — it only flips true on admin APPROVED, never on submission
  // alone, so an unverified claim can never affect a client's price. Workers
  // are legally required to register once their gross annual receipts cross
  // BIR's VAT threshold, regardless of trade — this is unrelated to whether
  // their trade counts as a PRC-licensed profession (see taxCertificateService
  // / AppSettings.atcCode, which is a separate, trade-based question).
  vatRegistered         Boolean            @default(false)
  vatDocumentUrl        String?
  vatVerificationStatus KycDocumentStatus?
  vatRejectionReason    String?
  vatSubmittedAt        DateTime?
  vatReviewedAt         DateTime?
  vatReviewedById       String? // soft reference — User.id of the admin who reviewed it

  // Set by the scheduled sweep (vatSummaryService.flagWorkersOverVatThreshold)
  // the first time this non-VAT-registered worker's trailing-12-month gross
  // receipts cross BIR's mandatory VAT-registration threshold — advisory
  // only, never auto-flips vatRegistered (that stays admin-approved-only,
  // see above). Prevents re-notifying the worker/admins every single sweep
  // tick once already flagged; naturally stops mattering once the worker
  // actually registers (vatRegistered becomes true, excluding them from the
  // sweep's query regardless of this field).
  vatThresholdFlaggedAt DateTime?

  // Platform commission + withholding tax owed on CASH jobs (paid to the
  // worker in person, so the platform's cut can't be skimmed from a gateway
  // transaction). Accrued by debtLedgerService.accrueDebtTx, netted against
  // the worker's next online-job payout by recoverDebtTx. Always >= 0 in
  // practice — represents money owed TO the platform, not a spendable
  // balance.
  commissionOwed Float @default(0)

  // Set when commissionOwed crosses AppSettings.workerDebtHoldLimit —
  // excludes the worker from matching/search and blocks new booking
  // acceptance (existing in-progress bookings are unaffected) until an
  // admin explicitly clears it via debtLedgerService.releaseDebtHold.
  // Deliberately does NOT auto-clear when the debt is later recovered.
  debtHoldAt   DateTime?
  debtHoldNote String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  serviceCategories  WorkerServiceCategory[]
  taskSelections     WorkerTaskSelection[]
  certifications     Certification[]
  scopeCapabilities  WorkerScopeFieldCapability[]
  reviews            Review[]
  resumeParseResult  ResumeParseResult?
  availability       WorkerAvailability[]
  availabilityTemplate WorkerAvailabilityTemplate[]
  packages           WorkerPackage[]
  taskPrices         WorkerTaskPrice[]
  tierPrices         WorkerTaskTierPrice[]
  debtLedger         DebtLedgerEntry[]

  @@index([userId])
  @@index([kycStatus])
  @@index([isAvailable])
  // Worker discovery search filters on both together on every request —
  // covers that combo directly instead of relying on a bitmap-AND of the
  // two single-column indexes above.
  @@index([isAvailable, kycStatus])
  @@index([debtHoldAt])
}

// Per-date/slot availability record used by auto-matching to find candidate
// workers for a given (date, timeSlot) — a normalized companion to the
// coarse-grained WorkerProfile.availableDays weekly pattern.
model WorkerAvailability {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  date      DateTime
  timeSlot  TimeSlot
  isBlocked Boolean  @default(false) // worker explicitly marked this date/slot unavailable
  isBooked  Boolean  @default(false) // an active booking currently occupies this slot — blocks closing it

  // Set when a worker's job overruns into this date/slot (see
  // bookingController.extendBooking) — a reservation for that spillover
  // work, not a real Booking. Soft reference (no FK, matches
  // Cancellation.cancelledById's convention) to the original booking that
  // caused the block, so cancelBooking/completeBooking/admin-cancel paths
  // can tell "a block I created that nothing ever claimed" (isBooked: false
  // -> safe to release) apart from a real booking now occupying it.
  blockedByBookingId String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerProfileId, date, timeSlot])
  @@index([workerProfileId, date])
}

// A worker's recurring weekly pattern (see B8) — materializeAvailabilityTemplates
// uses this to auto-open matching WorkerAvailability rows on a rolling
// forward window, so a worker with a stable schedule doesn't have to
// manually re-open the same days every week. Only ever CREATES rows that
// don't exist yet; never flips an existing row (a manual close, or a bulk
// "mark unavailable" block) back open.
model WorkerAvailabilityTemplate {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  dayOfWeek Int // 0=Sun ... 6=Sat, matches WorkerProfile.availableDays convention
  timeSlot  TimeSlot

  createdAt DateTime @default(now())

  @@unique([workerProfileId, dayOfWeek, timeSlot])
}

// ============================================================================
// KYC & VERIFICATION
// Web's AI-review pipeline (VerificationRequest) now acts as the umbrella
// submission; each document previously modeled separately in mobile's flat
// KycDocument now hangs off the request it was submitted for, so the AI
// fields (aiStatus/aiSummary/aiConfidence) apply to the whole submission and
// every document in it is traceable back to that review.
// ============================================================================

model VerificationRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type                String // e.g. "WORKER_ONBOARDING", "CERTIFICATION_ADD", "REVERIFICATION"
  status              KYCStatus @default(PENDING)
  rejectionReason     String?
  adminOverrideReason String?
  reviewedById        String?
  reviewedAt          DateTime?

  // AI-assisted review (carried over from web schema)
  aiStatus     String?
  aiSummary    String?
  aiConfidence Float?
  aiError      String?
  aiReviewedAt DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents KycDocument[]

  @@index([status])
  @@index([userId])
}

model KycDocument {
  id                    String              @id @default(cuid())
  verificationRequestId String
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  documentType KycDocumentType
  fileName     String?
  originalName String?
  fileUrl      String
  fileSize     Int?
  mimeType     String?

  status          KycDocumentStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?

  // Auto-computed at approval time for the government-clearance types
  // (NBI/police/barangay/cedula — see adminVerificationController.
  // approveDocument's CLEARANCE_VALIDITY_DAYS) using each type's real-world
  // validity period; null for ID/selfie/resume/certification, which don't
  // expire. Read by bookingWorker.flagExpiredKycDocuments to require
  // re-verification once it passes.
  expiresAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationRequestId, documentType])
  @@index([status])
  @@index([expiresAt])
}

model ResumeParseResult {
  id              String        @id @default(cuid())
  workerProfileId String        @unique
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  rawText           String?
  parsedSkills      String[]
  yearsOfExperience Int?
  masteryLevel      String?
  tradeCategory     String?
  summary           String?

  parsedAt  DateTime @default(now())
  modelUsed String   @default("claude-sonnet-4-6")

  @@index([workerProfileId])
}

model Certification {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  title       String
  issuer      String
  issueDate   DateTime
  expiryDate  DateTime?
  documentUrl String

  // Optional tag linking this certification to the specific trade it
  // licenses — null for a general certification with no licensing weight.
  // This is what workerController.addServiceCategory checks against
  // ServiceType.requiresCertification (and, for a worker's 2nd+ category
  // regardless of that flag): an APPROVED Certification tagged to that exact
  // service type is what lets a worker add/unlock it — see
  // WorkerServiceCategory.gatingCertificationId.
  serviceTypeId String?
  serviceType   ServiceType? @relation(fields: [serviceTypeId], references: [id], onDelete: SetNull)

  // Verification tracking
  verificationStatus KycDocumentStatus @default(PENDING)
  rejectionReason    String?
  reviewedAt         DateTime?

  // Worker-controlled display preference, independent of admin review —
  // a client only ever sees a certification when this is true AND
  // verificationStatus is APPROVED (see workerController.getWorkerDetail).
  // Defaults true so certifications already showing on public profiles
  // before this field existed don't silently disappear.
  visibleToClients Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Reverse side of WorkerServiceCategory.gatingCertificationId — the
  // category connection(s) this single document is gating approval for. In
  // practice at most one, since Certification.serviceTypeId ties one document
  // to one category.
  gatedCategories WorkerServiceCategory[]

  @@index([workerProfileId])
  @@index([verificationStatus])
  @@index([serviceTypeId])
}

// ============================================================================
// LEGAL
// ============================================================================

model ContractAcceptance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contractType    ContractType
  contractVersion String       @default("1.0")
  acceptedAt      DateTime     @default(now())
  ipAddress       String?
  userAgent       String?

  @@index([userId, contractType])
}

// ============================================================================
// SERVICES
// ============================================================================

model ServiceType {
  id          String  @id @default(cuid())
  name        String
  description String?
  basePrice   Float
  isActive    Boolean @default(true)

  // Ionicons outline name (e.g. "water-outline") picked from the curated
  // list in backend/src/constants/serviceIcons.ts — mobile renders this via
  // <Ionicons name={icon} />. Null means the category predates this field or
  // was never assigned one; mobile falls back to its static name-based guess
  // (utils/categoryIcons.ts) in that case.
  icon String?

  // A "licensed trade" (e.g. electrical, plumbing) an admin has flagged as
  // requiring proof of licensing before a worker can offer it — previously
  // ANY worker could self-add ANY category with zero credential check.
  // Enforced in workerController.addServiceCategory: gated on at least one
  // APPROVED Certification tagged to this exact ServiceType. As of
  // WorkerServiceCategory, a worker's 2nd+ category is gated the same way
  // regardless of this flag — see that model's docblock.
  requiresCertification Boolean @default(false)

  // Relations
  workerCategories WorkerServiceCategory[]
  tasks          ServiceTask[]
  packages       WorkerPackage[]
  scopeFields    ServiceScopeField[]
  certifications Certification[]

  @@unique([name])
}

// A worker's connection to a service category — replaces what used to be a
// bare WorkerProfile<->ServiceType many-to-many with no way to carry a status.
// A worker's FIRST category is VERIFIED immediately (gated only by
// ServiceType.requiresCertification, exactly as before this model existed).
// Every category beyond the first always requires the same single-document
// Certification review (regardless of requiresCertification) and starts
// PENDING_VERIFICATION — excluded from search/matching/booking (see
// workerController.searchWorkers, matchingService.findAutoMatchWorker,
// bookingController.createBooking) until an admin approves the gating
// Certification via adminCertificationController, which flips this row's
// status as a side effect. status is stored directly rather than derived
// from gatingCertification at query time because the exempt case (first
// category, no cert required) has nothing to join through, and every
// eligibility filter needs a plain indexed column to query against.
model WorkerServiceCategory {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  serviceTypeId   String
  serviceType     ServiceType   @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  status WorkerServiceCategoryStatus @default(VERIFIED)

  // The Certification gating this connection. Null only for the fully
  // ungated case (worker's first category, and it doesn't
  // requireCertification). SetNull (not Cascade) so a hard-deleted
  // Certification never cascades into deleting the category connection.
  gatingCertificationId String?
  gatingCertification   Certification? @relation(fields: [gatingCertificationId], references: [id], onDelete: SetNull)

  verifiedAt DateTime?
  rejectedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerProfileId, serviceTypeId])
  @@index([serviceTypeId, status])
  @@index([gatingCertificationId])
}

enum WorkerServiceCategoryStatus {
  PENDING_VERIFICATION
  VERIFIED
  REJECTED
}

// Admin-defined question shown in every category's booking "scope" step
// (e.g. "Appliance Type" for Appliance Repair, "Bedrooms" for Cleaning).
// Answers are snapshotted onto Booking.scopeAnswers keyed by `label`, not by
// this row's id, so editing/reordering fields later doesn't orphan past
// bookings.
model ServiceScopeField {
  id            String      @id @default(cuid())
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  label     String
  fieldType ScopeFieldType
  required  Boolean        @default(true)
  sortOrder Int            @default(0)

  // Only meaningful for fieldType = NUMBER.
  minValue Float?
  maxValue Float?

  // Admin opt-in: only turn this on for a SELECT/MULTI_SELECT field where
  // worker specialization is real (e.g. "Appliance Type," "Pest Type") — see
  // WorkerScopeFieldCapability. A field like "Color change" is still a
  // SELECT but every worker in the category can do any color, so it stays
  // off (the default) and is purely informational.
  usedForMatching Boolean @default(false)

  options ServiceScopeFieldOption[]

  // A PER_UNIT ServiceTask pointing at this field (fieldType must be NUMBER)
  // as its quantity source — see ServiceTask.quantityScopeFieldId. A field
  // can be reused as the quantity source for more than one task.
  quantityForTasks ServiceTask[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceTypeId])
}

model ServiceScopeFieldOption {
  id      String            @id @default(cuid())
  fieldId String
  field   ServiceScopeField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  label     String
  sortOrder Int    @default(0)

  workerCapabilities WorkerScopeFieldCapability[]

  @@index([fieldId])
}

// A worker declaring "I handle this specific option" for a scope field the
// admin flagged usedForMatching (e.g. checking "Air Conditioner" under
// Appliance Type). Discovery (workerController.searchWorkers,
// matchingService.findAutoMatchWorker) only enforces this against a worker
// who has *any* capability rows for that field's options at all — a worker
// with zero declarations is left unrestricted, the same "empty = no
// preference" rule WorkerProfile.preferredRoomTypes used before it was
// replaced by this general mechanism. Replaces the old free-text Skill
// model: nothing here is typed by the worker, every row points at a real
// admin-defined ServiceScopeFieldOption.
model WorkerScopeFieldCapability {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  optionId String
  option   ServiceScopeFieldOption @relation(fields: [optionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@unique([workerProfileId, optionId])
  @@index([optionId])
}

// A worker-defined, priced service bundle (e.g. "Deep Clean Package — ₱1500,
// includes fridge + oven + windows"), offered for one of the worker's own
// service categories. Replaces the old free/unpriced add-on toggles in the
// booking flow — see BookingAddOn for how a selected package is actually
// charged (resolved server-side to a priced add-on line item at booking
// creation, see bookingController.createBooking).
model WorkerPackage {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  serviceTypeId   String
  serviceType     ServiceType   @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Float
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerProfileId])
  @@index([serviceTypeId])
}

model ServiceTask {
  id            String      @id @default(cuid())
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  name        String
  description String?

  // "Typical/suggested" price — shown as the category-level range preview
  // before a client picks a worker (Booking Steps 1-2). Since WorkerTaskPrice
  // was introduced, this is NOT what a client is actually charged; see that
  // model + bookingController.createBooking for the authoritative per-worker
  // price. Kept as the seed anchor for minPrice/maxPrice below.
  basePrice Float

  pricingModel TaskPricingModel @default(FIXED)

  // Admin-allowed bound on what a worker may set via WorkerTaskPrice. FIXED:
  // bounds the flat price. PER_UNIT: bounds the per-unit rate. TIERED: bounds
  // every row of a worker's WorkerTaskTierPrice table. Both null for
  // CUSTOM_QUOTE (nothing to bound — worker prices on-site).
  minPrice Float?
  maxPrice Float?

  // PER_UNIT and TIERED only: display unit (e.g. "kilo", "sq.m.", "linear
  // meter") and the NUMBER-type ServiceScopeField (must belong to this
  // task's serviceType) whose answer supplies the quantity — multiplied
  // against a worker's WorkerTaskPrice.unitPrice for PER_UNIT, or resolved
  // against a worker's WorkerTaskTierPrice rows for TIERED.
  unitLabel            String?
  quantityScopeFieldId String?
  quantityScopeField   ServiceScopeField? @relation(fields: [quantityScopeFieldId], references: [id])

  // Nullable: CUSTOM_QUOTE jobs don't have a fixed duration.
  durationHours Float?
  isActive      Boolean @default(true)

  // Relations
  bookings   Booking[]
  workerPrices WorkerTaskPrice[]
  workerSelections WorkerTaskSelection[]
  workerTierPrices WorkerTaskTierPrice[]

  @@index([serviceTypeId])
  @@index([quantityScopeFieldId])
}

// A worker's own price for one ServiceTask, within that task's admin-set
// minPrice/maxPrice bound — mirrors WorkerPackage's shape and trust model
// exactly (ownership-gated CRUD in workerController, never trusted from the
// client at booking time: bookingController.createBooking re-fetches this
// row server-side by (workerProfileId, serviceTaskId), same as it already
// does for WorkerPackage). No row exists for a CUSTOM_QUOTE task — see
// ServiceTask.pricingModel. Price-only: whether the worker offers this task
// at all is WorkerTaskSelection's job, not this model's.
model WorkerTaskPrice {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  serviceTaskId   String
  serviceTask     ServiceTask   @relation(fields: [serviceTaskId], references: [id], onDelete: Cascade)

  price     Float? // FIXED model
  unitPrice Float? // PER_UNIT model
  isActive  Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerProfileId, serviceTaskId])
  @@index([serviceTaskId])
}

// A worker's own price *step* for a TIERED task — a worker has several of
// these per task (not unique per worker+task like WorkerTaskPrice, since a
// price table is many rows), each row valid for quantities up to `upToQty`.
// Resolution (see taskPriceService.resolveTierPrice) walks a worker's rows in
// ascending upToQty order and takes the first one where
// `upToQty == null || quantity <= upToQty` — null is only meaningful on the
// last row ("this price and above"). Deliberately NOT admin-defined brackets:
// every worker sets their own thresholds and prices independently, so there
// is no shared row for one worker's edit to disturb another's — setMyTaskPrice
// replaces a worker's whole table wholesale on every save (delete + recreate
// in one transaction) rather than upserting by id, which is safe here for
// exactly that reason (nothing else references one specific row by id; a
// Booking snapshots a plain basePrice number, never a row reference).
model WorkerTaskTierPrice {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  serviceTaskId   String
  serviceTask     ServiceTask   @relation(fields: [serviceTaskId], references: [id], onDelete: Cascade)

  upToQty Float? // null = open-ended top row ("this price and above")
  price   Float

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerProfileId, serviceTaskId])
}

// The single "worker offers this task" signal, for every pricing model —
// including CUSTOM_QUOTE, which never gets a WorkerTaskPrice row (priced
// on-site), so before this model existed there was no record at all of
// task-level selection for quote-based work. setMyTaskPrice upserts a
// matching row here so a FIXED/PER_UNIT task can't end up priced without
// being selected or vice versa. A row here may only exist for a task whose
// parent category has a WorkerServiceCategory row for the same worker (any
// status) — enforced in application code, not a DB constraint. Soft-toggle
// (isActive), matching WorkerTaskPrice's convention, so unchecking a task
// doesn't lose history.
model WorkerTaskSelection {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  serviceTaskId   String
  serviceTask     ServiceTask   @relation(fields: [serviceTaskId], references: [id], onDelete: Cascade)

  isActive Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerProfileId, serviceTaskId])
  @@index([serviceTaskId])
}

// ============================================================================
// BOOKINGS
// ============================================================================

model Booking {
  id String @id @default(cuid())

  // Parties — workerId is nullable to support open/unassigned marketplace
  // requests (web's behavior) that later get claimed or matched to a worker.
  clientId String
  client   User    @relation("client", fields: [clientId], references: [id], onDelete: Cascade)
  workerId String?
  worker   User?   @relation("worker", fields: [workerId], references: [id], onDelete: Cascade)

  // Auto-matching — set when the system assigned workerId rather than the
  // client picking a specific worker; declinedWorkerIds is the running
  // denormalized skip-list consulted on each match attempt (see DeclinedWorker
  // for the audited, per-attempt companion record).
  isAutoMatched     Boolean   @default(false)
  declinedWorkerIds String[]
  expiresAt         DateTime?

  // Set at creation (see bookingController.createBooking) when the target
  // worker's phone number matches the requesting client's own phone —
  // almost certainly the same person booking themselves (or a shared family
  // line), which could otherwise be used to farm reviews/payouts. Advisory
  // only, per the resolved policy: flag for admin review, don't block (a
  // shared household phone is a plausible false positive).
  selfDealingFlag Boolean @default(false)

  // Client-generated key (one per booking-draft submission attempt) so a
  // retried POST /bookings — app backgrounded mid-request, network timeout
  // + user taps Submit again — returns the already-created booking instead
  // of creating a duplicate. Scoped per-client, not global, since it's the
  // client that generates it. Null for older bookings created before this
  // existed and for any caller that doesn't send one.
  idempotencyKey String?

  // Service
  serviceType            String
  serviceTaskId          String?
  serviceTask            ServiceTask?   @relation(fields: [serviceTaskId], references: [id])
  description            String
  estimatedDurationHours Float?
  rooms                  RoomType[]
  condition              ConditionType?
  priorities             String[]
  addOnsSnapshot         Json? // itemized add-ons as submitted at booking time; BookingAddOn[] below is the normalized/authoritative record
  scopeAnswers           Json? // { [ServiceScopeField.label]: string | string[] } snapshot of this booking's scope-step answers
  issuePhotoUrls         String[]       @default([]) // client-attached photos of the issue, uploaded at Step 1 before the booking exists (see POST /bookings/issue-photo/upload)

  // Scheduling
  scheduledDate  DateTime
  scheduledTime  String?
  timeSlot       TimeSlot?
  urgencyLevel   UrgencyLevel @default(STANDARD)
  completionDate DateTime?

  // Status
  status BookingStatus @default(PENDING)

  // Pricing — initial estimate
  estimatedPrice Float
  tip            Float? @default(0)

  // VAT snapshot — vatApplicable/vatRate are pinned from the assigned
  // worker's WorkerProfile.vatRegistered at the earliest point a real price
  // is shown (createBooking for FIXED/PER_UNIT tasks; submitQuote for
  // CUSTOM_QUOTE, since estimatedPrice is 0 until then). Settlement
  // (paymentLifecycleService.priceBooking) always reads these, never the
  // worker's live status — so a worker becoming VAT-registered mid-job can't
  // change a price the client already agreed to. vatAmount is filled in at
  // settlement (the peso amount isn't knowable until the final subtotal is),
  // mirroring Payment.vatAmount for a permanent record on the booking itself.
  vatApplicable Boolean @default(false)
  vatRate       Float?
  vatAmount     Float?

  // Commission/withholding-tax snapshot — same reasoning as the VAT snapshot
  // above, pinned in acceptBooking (the one universal PENDING -> ACCEPTED
  // step every booking passes through, auto-matched or targeted) from
  // AppSettings.commissionRate/withholdingTaxRate at that moment. Without
  // this, paymentLifecycleService always read the LIVE AppSettings value at
  // settlement — potentially weeks after a worker accepted the job — so an
  // admin changing the platform's commission rate in that window silently
  // changed the split on jobs a worker had already agreed to and often
  // already completed. Nullable so older bookings (accepted before this
  // field existed) fall back to the live rate exactly as before.
  commissionRateSnapshot     Float?
  withholdingTaxRateSnapshot Float?

  // Quote lifecycle
  quoteStatus   QuoteStatus?
  laborCost     Float?
  materialsCost Float?
  quotedAt      DateTime?
  quoteNotes    String?
  approvedAt    DateTime?
  disputeReason String?

  // Stamped once, in acceptBooking, when a worker accepts a PENDING request.
  // Distinct from updatedAt, which moves on every later write to this row
  // (a quote, an add-on, a photo) and so can't be trusted as "when accepted"
  // — see getBookingDetail's timeline, which used to fall back to updatedAt.
  acceptedAt DateTime?

  // Set once the 12h "please approve/dispute this quote" reminder fires
  // (see bookingWorker.remindAndAutoApproveQuotes) — prevents re-sending it
  // on every hourly sweep tick, distinct from the 24h auto-approve itself.
  quoteReminderSentAt DateTime?

  // Reschedule-on-conflict — set when a DIFFERENT worker's booking spilled
  // into this one's original slot (see bookingController.extendBooking) and
  // this booking got moved to the worker's next open day for the same
  // TimeSlot. Status/workflow stage is untouched — this is a side-channel
  // schedule change, not a new BookingStatus (mirrors how arriveBooking
  // writes workerArrivedAt without transitioning status). Overwritten (not
  // appended) on a second hop if the spillover runs into a third+ day —
  // always reflects the latest move.
  rescheduledAt              DateTime?
  previousScheduledDate      DateTime?
  previousTimeSlot           TimeSlot?
  rescheduledFromBookingId   String? // soft reference — the original spilling-over booking's id, same convention as Cancellation.cancelledById
  rescheduleReminderSentAt   DateTime?
  // Non-null = this reschedule episode is resolved (client explicitly kept
  // the date, or the 24h auto-confirm fired) — doubles as the gate that lets
  // cancelBooking's post-PENDING carve-out apply.
  rescheduleAcknowledgedAt   DateTime?
  // The TRUE original date/slot, written once (only if still null) on the
  // FIRST hop and never touched again — previousScheduledDate/
  // previousTimeSlot above are overwritten on every hop and only ever
  // reflect the most recent move, so a client bounced twice
  // (Sept 20 -> Sept 22 -> Sept 25) would otherwise see "previously
  // Sept 22" with no way to learn they started at Sept 20 at all.
  originalScheduledDate DateTime?
  originalTimeSlot      TimeSlot?

  // Reschedule-ON-REQUEST — distinct from the reschedule-ON-CONFLICT fields
  // above (that's the worker's OTHER job spilling over onto THIS one; this
  // is THIS booking's own client asking for a different date, which the
  // assigned worker must explicitly accept — see
  // bookingController.requestReschedule). rescheduleRequestRespondedAt null
  // = still pending; once set, rescheduleRequestAccepted distinguishes
  // accepted (true) from declined (false) from withdrawn by the client
  // (null) — three outcomes sharing one "resolved" timestamp rather than a
  // separate status field per outcome.
  rescheduleRequestedAt           DateTime?
  requestedScheduledDate          DateTime?
  requestedTimeSlot                TimeSlot?
  rescheduleRequestReminderSentAt DateTime?
  rescheduleRequestRespondedAt    DateTime?
  rescheduleRequestAccepted       Boolean?

  // Dispute resolution audit — who (admin userId, no FK to keep this a soft
  // reference like VerificationRequest.reviewedById) resolved it and when.
  disputeResolvedById String?
  disputeResolvedAt   DateTime?

  // Inspection fee
  inspectionFeeCharged Boolean @default(false)
  inspectionFeeAmount  Float?

  // Final
  finalPrice Float?

  // Completion — worker-submitted proof photo, awaiting client confirmation
  completionPhotoUrl String?

  // Job execution timeline — discrete milestones distinct from completionDate
  // (client-confirmed) and workerArrivedAt (see ArrivalVerification for the
  // audited GPS check-in event this timestamp mirrors).
  workerArrivedAt   DateTime?
  workerStartedAt   DateTime?
  workerCompletedAt DateTime?

  // Set by the scheduled sweep (bookingWorker.flagWorkerNoShows) once an
  // ACCEPTED booking's scheduled slot start + AppSettings.noShowGraceHours
  // has passed with no workerArrivedAt — there was previously no concept of
  // a worker no-show at all, so a client whose worker simply never opened
  // the app again had no way to escape the booking (cancelBooking hard-
  // blocks a client past PENDING by design). Once set, cancelBooking's
  // post-PENDING carve-out lets the client cancel penalty-free, and the
  // resulting Cancellation is attributed to the worker
  // (Cancellation.penalizedWorkerId) for the auto-match scoring penalty.
  workerNoShowFlaggedAt DateTime?

  // Set once the 12h "please confirm this job is done" reminder fires (see
  // bookingWorker.autoSettleCompletedBookings) — prevents re-sending it on
  // every hourly sweep tick, distinct from the 24h auto-confirm itself.
  completionReminderSentAt DateTime?

  // Stamped when the booking enters AWAITING_PAYMENT (see
  // paymentLifecycleService.createCompletionInvoice) — the client already
  // confirmed and a checkout exists, so this is a much shorter, separate
  // reminder clock than completionReminderSentAt's 12h (a lower-friction
  // "you have one thing left to do" nudge, not "go review a photo").
  awaitingPaymentSince  DateTime?
  paymentReminderSentAt DateTime?

  // Payment method chosen by the client at booking time — settled upfront so
  // the client isn't asked to pick a method again after confirming completion.
  paymentMethodType        PaymentMethodType?
  paymentAccountIdentifier String?

  // Location
  location String
  city     String
  notes    String?

  // GPS snapshots. clientLat/clientLng is the booking address. workerLat/
  // workerLng starts as a copy of WorkerProfile.addressLat/addressLng at
  // booking-creation time (used to derive distanceMeters, the input to the
  // pricing distanceFee — see bookingController.createBooking) and is later
  // overwritten with the worker's real GPS once they check in as arrived
  // (see ArrivalVerification / bookingController.arriveBooking).
  clientLat      Float?
  clientLng      Float?
  workerLat      Float?
  workerLng      Float?
  distanceMeters Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  payment             Payment?
  review              Review?
  addOns              BookingAddOn[]
  declinedWorkers     DeclinedWorker[]
  arrivalVerification ArrivalVerification?
  cancellation        Cancellation?
  pricingLogs         PricingLog[]
  disputes            Dispute[]

  // Slot occupancy is enforced by a Postgres PARTIAL unique index
  // ("worker_live_slot_unique" on (workerId, scheduledDate, timeSlot) WHERE
  // status NOT IN ('REJECTED','CANCELLED')), hand-written in migration
  // 20260915000000_partial_unique_live_booking_slot — NOT declared here,
  // because Prisma's schema DSL has no way to express a partial (WHERE-
  // qualified) unique index for Postgres. A plain `@@unique` on these three
  // columns previously lived here, but since bookings are never deleted, a
  // single REJECTED or CANCELLED booking permanently squatted on that
  // worker/date/slot tuple forever — re-booking the exact same worker for
  // the exact same slot after a decline/cancellation failed with a
  // permanent, misleading 409, even though WorkerAvailability correctly
  // showed the slot open again. The partial index only makes "live"
  // bookings (everything except REJECTED/CANCELLED) mutually exclusive per
  // slot; NULL workerId (open/unassigned requests) stays unconstrained via
  // Postgres's normal NULL-distinct unique semantics, same as before.
  // IMPORTANT: because this index isn't in the datamodel, `prisma migrate
  // dev` cannot see it and may propose dropping it as drift on some future
  // migration — always review a generated migration's SQL before applying
  // it near the Booking model, and if one appears, delete that DROP INDEX
  // statement rather than letting it through.
  // Partial-unique-by-non-null: Postgres/Prisma treats NULL as distinct from
  // NULL in a unique index, so this only ever collides when a client
  // actually sends a (repeated) key — never blocks two real bookings that
  // both omit idempotencyKey.
  @@unique([clientId, idempotencyKey], name: "client_idempotency_key_unique")
  @@index([clientId, status])
  @@index([workerId, status])
  @@index([scheduledDate])
  @@index([status])
}

model BookingAddOn {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name  String
  price Float

  // A worker-added mid-job line item used to count toward the final bill
  // the instant it was created — no client consent step at all. Both null
  // = pending the client's response; the two are mutually exclusive.
  // Excluded from every finalPrice/settlement computation
  // (bookingController.getBookingDetail/approveQuote/completeBooking,
  // paymentLifecycleService.loadBooking) until clientApprovedAt is set —
  // either explicitly (respondToAddon) or by the reminder/auto-approve
  // sweep (bookingWorker.remindAndAutoApproveAddons) if the client never
  // responds. Any addon still pending when the job is marked complete
  // (bookingController.completeBooking) gets clientRejectedAt stamped
  // automatically — add-ons freeze at completion, so a still-open
  // approve/reject prompt afterward could never affect the already-locked
  // finalPrice anyway, and would just confuse the client.
  clientApprovedAt DateTime?
  clientRejectedAt DateTime?
  // Needed for the reminder/auto-approve sweep to know how long an addon
  // has been pending — nothing else on this model was ever timestamped.
  createdAt DateTime @default(now())
  // Set once the 2h "please approve/reject this addon" reminder fires (see
  // bookingWorker.remindAndAutoApproveAddons) — prevents re-sending it on
  // every hourly sweep tick, same convention as
  // Booking.quoteReminderSentAt.
  reminderSentAt DateTime?

  @@index([bookingId])
}

// ============================================================================
// BOOKING FLOW — MATCHING, ARRIVAL, CANCELLATION, PRICING, DISPUTES
// Worker/actor references below are intentionally soft (plain String id, no
// FK) to match the existing audit-style convention already used elsewhere
// (AuditLog.actorId, VerificationRequest.reviewedById, Booking.disputeResolvedById).
// ============================================================================

// Per-attempt audit trail for auto-matching skip logic — Booking.declinedWorkerIds
// is the fast denormalized read; this is the "why/when" companion.
model DeclinedWorker {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  workerId String // soft reference — worker who declined or was skipped
  reason   String?

  declinedAt DateTime @default(now())

  @@unique([bookingId, workerId])
}

// GPS check-in event recorded when a worker marks themselves as arrived at
// the job site — the immutable audit record; Booking.workerLat/workerLng
// hold the live/last-known position.
model ArrivalVerification {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  workerLat      Float
  workerLng      Float
  distanceMeters Float
  isVerified     Boolean @default(false) // within the accepted geofence radius
  // Flag-only (see C9) — true when the check-in fell outside the booking's
  // scheduled date/timeSlot window. Never blocks arrival, just surfaces it
  // for admin dispute review.
  isOutsideBookedWindow Boolean @default(false)
  // Android-only signal (`Location.isFromMockProvider()`) that the reported
  // fix came from a mock-location provider. A true value hard-blocks the
  // check-in itself (see arriveBooking) so this only records false/unknown
  // on the row that actually got created — kept for audit completeness.
  mockedLocation Boolean @default(false)

  createdAt DateTime @default(now())
}

model Cancellation {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  cancelledBy   Role // CLIENT, WORKER, or ADMIN
  cancelledById String // soft reference to the user who cancelled
  reason        String?
  // Hours of notice between this cancellation and the booking's scheduled
  // slot start — only recorded for WORKER cancellations (see B6), since
  // those are the ones that leave a client stranded on short notice. 0 means
  // the slot had already started (or passed) at cancel time. Null for
  // CLIENT/ADMIN cancellations, where "notice" isn't the relevant signal.
  cancelledWithinHours Int?

  // Required when a worker cancels (bookingController.cancelBooking) — lets
  // them distinguish "my fault" from "the client wasn't there" or an
  // unrelated reason. Previously every late worker cancellation was
  // penalized identically regardless of whose fault it actually was,
  // discouraging workers from ever honestly reporting a client no-show.
  workerCancellationReason WorkerCancellationReason?

  // The worker whose matchingService auto-match score should take the late-
  // cancel penalty for this cancellation, resolved once at creation time
  // (soft reference, same convention as cancelledById) — null means no
  // penalty. Two cases set this: (1) the WORKER cancelled within
  // LATE_CANCEL_THRESHOLD_HOURS AND self-reported WORKER_FAULT (equals
  // cancelledById); (2) the CLIENT cancelled via the no-show carve-out
  // after the worker never showed up (see Booking.workerNoShowFlaggedAt) —
  // equals booking.workerId, NOT cancelledById, since the client performed
  // the action but the worker is who should be penalized. Replaces the old
  // matchingService query that only ever looked at cancelledBy='WORKER',
  // which could never account for case (2).
  penalizedWorkerId String?

  createdAt DateTime @default(now())
}

enum WorkerCancellationReason {
  WORKER_FAULT
  CLIENT_NO_SHOW
  OTHER
}

// Itemized pricing snapshot — logged whenever the estimate is (re)computed,
// e.g. on initial submit and again after condition/distance are known.
model PricingLog {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  basePrice     Float
  conditionFee  Float? @default(0)
  distanceFee   Float? @default(0)
  urgencyFee    Float? @default(0)
  tierFee       Float? @default(0)
  addOnsTotal   Float? @default(0)
  finalEstimate Float
  breakdown     Json? // full itemized snapshot for support/audit lookups

  createdAt DateTime @default(now())

  @@index([bookingId])
}

model Dispute {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  raisedById   String // soft reference — client or worker who raised it
  reason       String
  evidenceUrls String[]

  status       String    @default("OPEN") // 'OPEN' | 'UNDER_REVIEW' | 'RESOLVED' | 'REJECTED'
  resolution   String?
  resolvedById String? // soft reference — admin who resolved it
  resolvedAt   DateTime?
  refundAmount Float?

  // Outcome of the CANCEL_BOOKING refund/void attempt (see
  // adminDisputeController.resolveDispute) — distinct from `status`, which
  // reflects the dispute itself being resolved. A dispute can be fully
  // RESOLVED_CANCELLED while its refund still FAILED (Xendit refund
  // rejected, or the worker payout already went out and needs a manual
  // clawback) — that combination used to be silently swallowed into a
  // console.error with the API still reporting success. NOT_APPLICABLE for
  // every action other than CANCEL_BOOKING, and for CANCEL_BOOKING cases
  // where there was nothing to refund (no payment, or already PENDING/void).
  refundStatus        String  @default("NOT_APPLICABLE") // 'NOT_APPLICABLE' | 'SUCCEEDED' | 'FAILED'
  refundFailureReason String?

  // SLA sweep (bookingWorker.escalateStaleDisputes) — re-notifies admins
  // every AppSettings.disputeEscalationHours while this dispute stays
  // OPEN/UNDER_REVIEW, so an admin who never looks at a dispute doesn't
  // leave it (and the booking + worker payout it's freezing) stuck forever.
  // Null means never yet escalated; re-set on every repeat reminder, same
  // recurring-nag convention as a real SLA breach rather than a one-shot
  // notice that goes silent after the first ping.
  staleReminderSentAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Amounts
  subtotal Float
  tip      Float @default(0)

  // Commission
  commissionRate   Float @default(0.10)
  commissionAmount Float

  // Withholding tax (BIR compliance — contractor-category workers, see
  // AppSettings.atcCode for the current code)
  withholdingTaxRate   Float @default(0.02)
  withholdingTaxAmount Float

  // VAT collected on behalf of BIR from a VAT-registered worker's price —
  // snapshotted from the booking (see Booking.vatApplicable/vatRate above),
  // never re-derived from the worker's live status. This is NOT platform
  // revenue and is never netted against commission/withholding — see
  // VatCollectionSummary, which is what sources the worker-facing "VAT you
  // collected" report from this field, not TaxRemittance.
  vatApplicable Boolean @default(false)
  vatRate       Float?
  vatAmount     Float   @default(0)

  // Worker receives
  workerPayout Float

  // Total charged to client
  totalAmount Float

  // Status
  status       PaymentStatus @default(PENDING)
  escrowStatus EscrowStatus  @default(HELD)
  releasedAt   DateTime?

  // Refund audit
  refundReason String?
  refundedAt   DateTime?

  // Set when status becomes FAILED — raw reason from Xendit's webhook
  // payload (translated for end users via utils/xenditFailureMessages.ts).
  failureReason String?

  // Xendit references. xenditInvoiceId is set at checkout-creation time and
  // is what the invoice-paid webhook uses to find this row. xenditPaymentId
  // is populated only once the webhook reports the invoice PAID (Xendit's
  // payment_id, e.g. "ewc_...") and is surfaced to the client as the
  // receipt's transactionId.
  // @unique: defense-in-depth — no known live collision path today, but two
  // Payment rows must never be able to share an invoice id (the invoice-paid
  // webhook looks the row up by this field, so a collision would let one
  // invoice's webhook settle the wrong booking's payment). Postgres treats
  // multiple NULLs as distinct, so unset values (pre-checkout rows, CASH/
  // platform-funded payments that never get a Xendit invoice) are unaffected.
  xenditInvoiceId String? @unique
  xenditPaymentId String?

  // Authorize/capture flow — amount is held (authorized) at booking time and
  // captured on completion; capturedAmount may differ from authorizedAmount
  // if the final price changed (e.g. quote approval, add-ons).
  authorizedAmount Float?
  authorizedAt     DateTime?
  capturedAmount   Float?
  capturedAt       DateTime?
  // Deprecated — populated only on CARD-era rows from before CARD support
  // was removed; no longer written to.
  authorizationId  String?
  paymentIntentId  String?
  clientSecret     String?

  // Payment method used
  methodType        PaymentMethodType
  accountIdentifier String? // masked GCash/Maya number, etc.

  // Set once the worker's earnings have been settled for this payment (payout
  // scheduled and/or wallet debt netted). Idempotency guard for
  // paymentLifecycleService.settleWorkerEarnings — a replayed webhook or the
  // self-heal sweep must not net the debt or pay out twice.
  workerSettledAt DateTime?

  // True only for the PAY_WORKER_FROM_PLATFORM admin override
  // (paymentLifecycleService.settlePlatformFundedPayment) — the client
  // never paid, but the platform settled the worker's earnings out of its
  // own funds rather than continue chasing an unpaid client. subtotal/
  // commissionAmount/withholdingTaxAmount/vatAmount/workerPayout still
  // reflect the normal computed split (the worker received real taxable
  // income regardless of who funded it, so 2307/withholding reporting stays
  // correct) — but vatSummaryService must exclude these rows from "VAT
  // collected from clients" reporting, since no client payment happened.
  platformFunded Boolean @default(false)

  payout Payout?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([escrowStatus])
}

// Tracks the actual disbursement of a worker's payout via Xendit, separate
// from Payment.escrowStatus (which only tracks the platform's own escrow
// ledger — RELEASED means "the worker's cut is owed", not "the worker has
// been paid"). One Payout per Payment, created once escrow is released.
model Payout {
  id        String  @id @default(cuid())
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bookingId String // denormalized for cheap admin filtering, soft reference like Dispute.raisedById
  workerId  String // soft reference — User.id of the worker being paid

  amount        Float
  channel       PaymentMethodType // GCASH/MAYA — CASH is not a valid payout channel
  accountName   String? // snapshot of WorkerProfile.payoutAccountName at send time
  accountNumber String // snapshot of WorkerProfile.payoutAccountNumber at send time

  status               PayoutStatus @default(PENDING)
  xenditDisbursementId String?      @unique // Xendit Payouts API `id` (e.g. "disb-...")
  xenditStatus         String? // raw status from Xendit (ACCEPTED/COMPLETED/FAILED/...), for debugging
  failureReason        String?
  attempts             Int          @default(0)

  processingAt DateTime?
  paidAt       DateTime?
  failedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([workerId])
  @@index([status])
}

enum DebtLedgerEntryType {
  // Platform commission + withholding tax owed on a CASH job, where the client
  // paid the worker in person. Increases commissionOwed.
  COMMISSION_DEBIT
  // Withheld from an online job's payout to pay down outstanding
  // commissionOwed before the remainder is disbursed. Decreases commissionOwed.
  DEBT_RECOVERY
  // Admin manual correction (either direction), always requires a note.
  ADMIN_ADJUSTMENT
  // A previously-accrued COMMISSION_DEBIT reversed because the underlying
  // cash payment was refunded/voided. Decreases commissionOwed.
  REVERSAL
}

// Audit trail for WorkerProfile.commissionOwed — a running tab of platform
// dues, not a spendable balance. See debtLedgerService.ts.
model DebtLedgerEntry {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  type DebtLedgerEntryType

  // Signed: COMMISSION_DEBIT/negative ADMIN_ADJUSTMENT increase what's owed
  // (positive amount here), DEBT_RECOVERY/REVERSAL/positive ADMIN_ADJUSTMENT
  // decrease it (negative amount here). balanceAfter is always the resulting
  // commissionOwed.
  amount       Float
  balanceAfter Float

  bookingId String? // soft reference — links an entry to the job it was for
  note      String? // admin's reason, for ADMIN_ADJUSTMENT rows

  createdAt DateTime @default(now())

  @@index([workerProfileId])
  @@index([bookingId])
}

model SavedPaymentMethod {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  type              PaymentMethodType
  accountIdentifier String? // masked — last 4 digits or masked phone number
  label             String? // e.g. "My GCash", "Work Card"
  isDefault         Boolean           @default(false)

  createdAt DateTime @default(now())

  @@index([clientProfileId])
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  rating    Float // 1.0 to 5.0
  comment   String?
  photoUrls String[] @default([]) // client-attached photos, uploaded via POST /bookings/:id/review-photo/upload

  // Moderation — admin-side flagging/hiding, see ReviewStatus
  flagged    Boolean      @default(false)
  flagReason String?
  status     ReviewStatus @default(VISIBLE)

  // The worker's one-time public reply to this review — previously there
  // was no way for a worker to respond to a review at all, even an unfair
  // or inaccurate one. Settable once (see workerController.respondToReview);
  // null means no response yet.
  workerResponse   String?
  workerResponseAt DateTime?

  createdAt DateTime @default(now())

  @@index([workerId])
  @@index([clientId])
  @@index([flagged])
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  WARNED
}

// ============================================================================
// MESSAGING
// ============================================================================

model Message {
  id         String @id @default(cuid())
  senderId   String
  sender     User   @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User   @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  content  String
  imageUrl String?
  isRead   Boolean   @default(false)
  readAt   DateTime?

  // Minimal report-and-flag-for-admin moderation — not a block-list feature.
  // Set together by messageController.reportMessage when the recipient
  // reports a message; every admin is notified (MESSAGE_REPORTED) the same
  // way KYC/dispute review queues notify admins elsewhere.
  reportedAt   DateTime?
  reportReason String?

  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String
  relatedId String?
  isRead    Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
}

// ============================================================================
// ADMIN — AUDIT LOG, PRICING RULES, SETTINGS
// ============================================================================

model AuditLog {
  id        String  @id @default(cuid())
  actorId   String?
  actorName String?
  actorRole String?

  action   String // e.g. 'USER_LOGIN_SUCCESS', 'BOOKING_DECLINED', 'DISPUTE_RESOLVED'
  category String // 'ADMIN_ACTION' | 'LOGIN' | 'SYSTEM_ERROR' | 'STATUS_CHANGE'
  level    String @default("INFO") // 'INFO' | 'WARN' | 'ERROR'
  message  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
  @@index([actorId])
}

model PricingRule {
  id          String @id @default(cuid())
  city        String
  serviceType String
  minPrice    Float
  maxPrice    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([city, serviceType])
}

model AppSettings {
  id                   String  @id @default("singleton")
  siteName             String  @default("HomeEaseAdmin")
  supportEmail         String  @default("support@homeease.dev")
  notificationsEnabled Boolean @default(true)

  // Platform configuration — live business rules read at runtime by the
  // booking/payment/worker-availability flows (see appSettingsService).
  commissionRate       Float @default(0.10)
  withholdingTaxRate   Float @default(0.02)
  maxSlotsPerDay       Int   @default(2)

  // BIR Alphanumeric Tax Code for the withholding tax certificate (Form
  // 2307) — see taxCertificateService. Data, not a hardcoded constant: kept
  // null on a fresh environment and certificate generation refuses to issue
  // rather than silently default to a possibly-wrong code. Current value
  // (WI120, "income payments to certain contractors") was corrected 2026-09-14
  // from a mismatched WC158 after checking the actual BIR ATC table — WC158
  // is goods-suppliers-at-1%, not this. One code covers every worker
  // regardless of VAT registration: none of this platform's trades are
  // PRC-licensed professions, so the VAT-status-split article never applied.
  atcCode String?
  pendingExpiryMinutes Int   @default(60)
  geofenceRadiusMeters Int   @default(100)

  // Worker decline-limit cooldown (see bookingController.declineBooking) —
  // hit maxDeclinesBeforeCooldown declines within declineWindowHours and the
  // worker is excluded from auto-match for declineCooldownHours.
  maxDeclinesBeforeCooldown Int @default(3)
  declineWindowHours        Int @default(168) // 7 days
  declineCooldownHours      Int @default(24)

  // Expertise-tier pricing (see utils/workerTier.ts) — tier is computed on
  // the fly from WorkerProfile.rating + completed-job count, not stored;
  // these thresholds/multipliers are the only admin-configurable part.
  tierProMinRating     Float @default(4.5)
  tierProMinJobs       Int   @default(20)
  tierProMultiplier    Float @default(1.15)
  tierExpertMinRating  Float @default(4.8)
  tierExpertMinJobs    Int   @default(50)
  tierExpertMultiplier Float @default(1.3)

  // Distance fee (see utils/pricing.computeJobPricing) — km within
  // freeDistanceKm of a worker's service address are free, every km beyond
  // that costs perKmFee. Used to be hardcoded constants; moved here so an
  // admin can tune them the same way as the tier multipliers above, without
  // a redeploy.
  freeDistanceKm Float @default(5)
  perKmFee       Float @default(10)

  // Threshold on WorkerProfile.commissionOwed (see debtLedgerService.ts) —
  // crossing this puts the worker's account on hold until an admin clears it.
  workerDebtHoldLimit Float @default(500)

  // Grace period past an ACCEPTED booking's scheduled slot start before the
  // worker-no-show sweep (bookingWorker.flagWorkerNoShows) flags it —
  // see Booking.workerNoShowFlaggedAt.
  noShowGraceHours Int @default(2)

  // How long a dispute can sit OPEN/UNDER_REVIEW before the SLA sweep
  // (bookingWorker.escalateStaleDisputes) re-notifies admins — previously a
  // dispute an admin never looked at just sat there forever with the
  // booking and worker payout both frozen.
  disputeEscalationHours Int @default(48)

  // Automatic suspension sweep (bookingWorker.autoSuspendUnderperformingWorkers)
  // — both null by default, meaning OFF: there was previously no mechanism
  // tying a worker's rating or dispute history to their account status at
  // all, no matter how bad either got. An admin opts in by setting both a
  // rating floor and a dispute-count/window pair; leaving either null keeps
  // the sweep a no-op rather than guessing sensible thresholds on their
  // behalf. Only ever SUSPENDS (never bans) — reversible, admin still
  // reviews and reinstates.
  autoSuspendRatingThreshold        Float?
  autoSuspendDisputeCountThreshold  Int?
  autoSuspendDisputeCountWindowDays Int?

  updatedAt DateTime @updatedAt
}

enum TaxCertificateStatus {
  DRAFT // aggregated + PDF generated, not yet released to the worker
  ISSUED // visible to the worker in-app (see workerController.getMyTaxCertificates)
  // A payment counted in this certificate's totals was refunded after the
  // certificate was already issued (see
  // paymentLifecycleService.flagTaxRecordsForRefundedPayment) — the figures
  // on the issued PDF now overstate real income/tax withheld. Sits outside
  // the normal DRAFT->ISSUED flow; an admin must review and reissue a
  // corrected certificate, there's no automatic correction.
  NEEDS_REVIEW
}

// BIR Form 2307 (Certificate of Creditable Tax Withheld at Source) data —
// one row per worker per reporting period. Generated from Payment rows by
// taxCertificateService; see that file for the caveat that the rendered PDF
// is not guaranteed to match BIR's exact official template.
model TaxCertificate {
  id       String @id @default(cuid())
  workerId String // soft reference — User.id of the worker, same convention as Payout.workerId

  periodStart DateTime
  periodEnd   DateTime

  // Snapshots at generation time — same "don't let a later profile edit
  // silently rewrite an already-issued record" convention as
  // Payout.accountName/accountNumber.
  workerName String
  workerTin  String

  totalIncomePayments Float // sum of (Payment.subtotal - Payment.commissionAmount) captured in the period
  totalTaxWithheld    Float // sum of Payment.withholdingTaxAmount captured in the period

  pdfPath String // Supabase Storage object path in a PRIVATE bucket — a signed URL is minted on read, never stored here
  status  TaxCertificateStatus @default(DRAFT)

  issuedAt    DateTime?
  generatedBy String // soft reference — User.id of the admin who triggered generation

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerId, periodStart, periodEnd])
  @@index([workerId])
  @@index([status])
}

// Deliberately separate from TaxCertificate/TaxRemittance — this is VAT a
// worker collected on their own sales (12% they charged on top of their
// price because they're VAT-registered), which the PLATFORM never remits;
// the worker files it themselves via their own 2550Q/2551Q. Keeping it a
// distinct model makes "informational only, carries no platform liability"
// structural rather than a fact someone has to remember when querying.
// Sourced from Payment.vatAmount (what was legally collected per job), never
// Payout.amount (see paymentLifecycleService — a cash job's debt clawback can
// make those two numbers differ).
model VatCollectionSummary {
  id       String @id @default(cuid())
  workerId String // soft reference — User.id, same convention as TaxCertificate.workerId

  periodStart DateTime
  periodEnd   DateTime

  workerName String // snapshot at generation time, same convention as TaxCertificate.workerName

  totalVatCollected Float // sum of Payment.vatAmount for this worker in the period

  // Same reasoning as TaxCertificate/TaxRemittance's NEEDS_REVIEW status —
  // no separate status enum here since this model only ever had one state,
  // so a boolean flag is enough. Set when a payment counted in
  // totalVatCollected is refunded after this summary was already generated
  // (see paymentLifecycleService.flagTaxRecordsForRefundedPayment).
  needsReview Boolean @default(false)

  generatedBy String // soft reference — User.id of the admin who triggered generation
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@unique([workerId, periodStart, periodEnd])
  @@index([workerId])
}

enum TaxRemittanceStatus {
  PENDING
  REMITTED
  // Same reasoning as TaxCertificateStatus.NEEDS_REVIEW — a payment counted
  // in this period's totalTaxWithheld was refunded after the period was
  // already marked REMITTED, so the recorded figure now overstates what was
  // actually due. Needs an admin to review the real over-remittance amount;
  // there's no automated BIR correction filing.
  NEEDS_REVIEW
}

// Bookkeeping/audit trail for the platform's own BIR remittance of withheld
// tax — there is no public BIR e-filing API, so actual filing/payment
// happens outside the app (eFPS or an authorized bank); this just tracks
// that it happened. One row per reporting period, aggregated across all
// workers. See taxRemittanceService.
model TaxRemittance {
  id String @id @default(cuid())

  periodStart DateTime
  periodEnd   DateTime

  totalTaxWithheld Float // sum of Payment.withholdingTaxAmount captured in the period, across all workers

  status          TaxRemittanceStatus @default(PENDING)
  referenceNumber String? // BIR/bank OR number, set once actually filed/paid
  remittedAt      DateTime?
  remittedBy      String? // soft reference — User.id of the admin who marked this remitted
  notes           String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([periodStart, periodEnd])
  @@index([status])
}
