// ============================================================================
// UNIFIED SCHEMA
// Merges: web app schema (AI-assisted verification pipeline) +
//         mobile app schema (marketplace booking/quote/escrow/payment engine)
// See accompanying notes for merge decisions and open questions.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Connection URLs now live in prisma.config.ts (Prisma ORM 7+)
}

// ============================================================================
// ENUMS
// ============================================================================

enum Role {
  CLIENT
  WORKER
  ADMIN
}

enum TokenType {
  ACCESS
  REFRESH
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

enum BookingStatus {
  PENDING
  ACCEPTED
  REJECTED
  IN_PROGRESS
  QUOTE_SUBMITTED
  QUOTE_APPROVED
  DISPUTED
  PENDING_COMPLETION
  COMPLETED
  CANCELLED
}

enum QuoteStatus {
  PENDING
  SUBMITTED
  APPROVED
  DISPUTED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum EscrowStatus {
  HELD
  RELEASED
  REFUNDED
}

enum PayoutStatus {
  PENDING // Payout row created, not yet sent to PayMongo
  PROCESSING // PayMongo transfer created, awaiting callback confirmation
  PAID // PayMongo confirmed the transfer succeeded
  FAILED // PayMongo confirmed failure, or a platform-side error before send
}

enum PaymentMethodType {
  GCASH
  MAYA
  CASH
}

enum KYCStatus {
  PENDING
  SUBMITTED
  APPROVED
  REJECTED
}

enum KycDocumentType {
  GOVERNMENT_ID_FRONT
  GOVERNMENT_ID_BACK
  SELFIE
  RESUME
  CERTIFICATION
  NBI_CLEARANCE
  BARANGAY_CLEARANCE
  POLICE_CLEARANCE
  CEDULA
}

enum KycDocumentStatus {
  PENDING
  APPROVED
  REJECTED
}

enum ContractType {
  WORKER_SERVICE_AGREEMENT
  CLIENT_USER_AGREEMENT
}

enum NotificationType {
  BOOKING_REQUEST
  BOOKING_ACCEPTED
  BOOKING_REJECTED
  BOOKING_CANCELLED
  BOOKING_RESCHEDULED
  BOOKING_COMPLETED
  PAYMENT_RECEIVED
  PAYMENT_REFUNDED
  ADDON_ADDED
  REVIEW_RECEIVED
  MESSAGE_RECEIVED
  VERIFICATION_EMAIL
  PASSWORD_RESET
  QUOTE_SUBMITTED
  QUOTE_APPROVED
  QUOTE_DISPUTED
  VERIFICATION_SUBMITTED
  VERIFICATION_APPROVED
  VERIFICATION_REJECTED
  PAYOUT_SENT
  PAYOUT_FAILED
}

enum TimeSlot {
  MORNING
  AFTERNOON
  EVENING
}

enum UrgencyLevel {
  STANDARD
  URGENT
  EMERGENCY
}

enum RoomType {
  BEDROOM
  BATHROOM
  KITCHEN
  LIVING_ROOM
  DINING_ROOM
  OFFICE
  GARAGE
  BALCONY
  OTHER
}

enum ConditionType {
  TIDY
  NORMAL
  HEAVY
}

// Whether a service's booking "scope" step is the generic room picker
// (Cleaning, Painting, ...) or an admin-defined set of custom fields
// (Appliance Repair: "which appliance", Pest Control: "describe the issue").
enum ServiceScopeType {
  ROOM_BASED
  CUSTOM
}

enum ScopeFieldType {
  TEXT
  SELECT
  MULTI_SELECT
}

// ============================================================================
// USER & AUTH
// ============================================================================

model User {
  id       String  @id @default(cuid())
  email    String  @unique
  phone    String?
  password String
  fullName String
  role     Role

  isVerified              Boolean @default(false) // basic email/phone verification, not KYC
  avatar                  String?
  notificationPreferences Json?
  // Expo push token for the device the user most recently logged in on —
  // single-device by design (matches the mobile client's single in-memory
  // token model). Overwritten on each login/registration; cleared on logout.
  pushToken               String?

  // Soft delete — isDeleted/deletedAt is the single gate used everywhere to
  // exclude a user from active queries. `status` records *why* — self-deleted,
  // admin-suspended, or admin-banned — so those cases stay distinguishable.
  isDeleted Boolean    @default(false)
  deletedAt DateTime?
  status    UserStatus @default(ACTIVE)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  clientProfile        ClientProfile?
  workerProfile        WorkerProfile?
  addresses            UserAddress[]
  sentMessages         Message[]             @relation("sender")
  receivedMessages     Message[]             @relation("receiver")
  bookingsAsClient     Booking[]             @relation("client")
  bookingsAsWorker     Booking[]             @relation("worker")
  reviews              Review[]
  notifications        Notification[]
  authTokens           AuthToken[]
  verificationRequests VerificationRequest[]
  contractAcceptances  ContractAcceptance[]

  @@index([email])
  @@index([role])
  @@index([isDeleted])
  @@index([status])
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
  DELETED
}

model UserAddress {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  label     String?
  street    String
  city      String
  state     String?
  zipCode   String?
  isDefault Boolean @default(false)

  // Soft delete
  isDeleted Boolean   @default(false)
  deletedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId])
  @@index([userId, isDefault])
}

model AuthToken {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  token     String    @unique
  type      TokenType
  expiresAt DateTime
  createdAt DateTime  @default(now())

  @@index([userId])
  @@index([token])
}

// ============================================================================
// PROFILES
// ============================================================================

model ClientProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  address String?
  city    String?
  state   String?
  zipCode String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  paymentMethods SavedPaymentMethod[]

  @@index([userId])
}

model WorkerProfile {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  bio          String?
  rating       Float   @default(5.0)
  totalReviews Int     @default(0)

  // Digital ID card fields — shown to clients in person (digital-id.tsx).
  // Distinct from serviceAreaRadius (a booking-matching radius in km) and
  // ResumeParseResult.tradeCategory (AI-extracted, not worker-edited).
  digitalIdTrade       String?
  digitalIdServiceArea String?
  licenseNumber        String?

  // Availability & Capacity
  isAvailable       Boolean @default(true)
  maxConcurrentJobs Int     @default(2)
  activeJobCount    Int     @default(0)
  availableDays     Int[]   @default([1, 2, 3, 4, 5]) // 0=Sun, 1=Mon ... 6=Sat
  serviceAreaRadius Int     @default(30) // in kilometers

  // Set when the worker hits AppSettings.maxDeclinesBeforeCooldown declines
  // within the rolling declineWindowHours — excluded from auto-match
  // candidates (see matchingService.findAutoMatchWorker) until this passes.
  declineCooldownUntil DateTime?

  // Job preferences — used by auto-matching to filter candidate workers
  acceptsHeavyCondition Boolean    @default(false)
  acceptsPets           Boolean    @default(false)
  preferredRoomTypes    RoomType[]

  // Hourly rate the worker charges — surfaced in search results and used to
  // compute estimatedTotal; distinct from per-skill Skill.rate, which is more
  // granular but optional (not every worker sets skill-level rates).
  hourlyRate Float?

  // Location
  address String?
  city    String?
  state   String?
  zipCode String?

  // Live GPS location — updated while a worker is en route/on a job, used
  // for arrival verification and distance-based matching.
  currentLat         Float?
  currentLng         Float?
  lastLocationUpdate DateTime?

  // KYC — denormalized snapshot; source of truth is VerificationRequest
  kycStatus      KYCStatus @default(PENDING)
  kycSubmittedAt DateTime?
  kycApprovedAt  DateTime?

  // Resume file URL (raw file)
  resumeUrl String?

  // Payout destination for withdrawing earnings (worker-configured)
  payoutMethod        PaymentMethodType?
  payoutAccountName   String?
  payoutAccountNumber String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  serviceTypes      ServiceType[]
  certifications    Certification[]
  skills            Skill[]
  reviews           Review[]
  resumeParseResult ResumeParseResult?
  availability      WorkerAvailability[]
  packages          WorkerPackage[]
  wallet            WorkerWallet?

  @@index([userId])
  @@index([kycStatus])
  @@index([isAvailable])
}

// Per-date/slot availability record used by auto-matching to find candidate
// workers for a given (date, timeSlot) — a normalized companion to the
// coarse-grained WorkerProfile.availableDays weekly pattern.
model WorkerAvailability {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  date      DateTime
  timeSlot  TimeSlot
  isBlocked Boolean  @default(false) // worker explicitly marked this date/slot unavailable
  isBooked  Boolean  @default(false) // an active booking currently occupies this slot — blocks closing it

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([workerProfileId, date, timeSlot])
  @@index([workerProfileId, date])
}

// ============================================================================
// KYC & VERIFICATION
// Web's AI-review pipeline (VerificationRequest) now acts as the umbrella
// submission; each document previously modeled separately in mobile's flat
// KycDocument now hangs off the request it was submitted for, so the AI
// fields (aiStatus/aiSummary/aiConfidence) apply to the whole submission and
// every document in it is traceable back to that review.
// ============================================================================

model VerificationRequest {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type                String // e.g. "WORKER_ONBOARDING", "CERTIFICATION_ADD", "REVERIFICATION"
  status              KYCStatus @default(PENDING)
  rejectionReason     String?
  adminOverrideReason String?
  reviewedById        String?
  reviewedAt          DateTime?

  // AI-assisted review (carried over from web schema)
  aiStatus     String?
  aiSummary    String?
  aiConfidence Float?
  aiError      String?
  aiReviewedAt DateTime?

  submittedAt DateTime @default(now())
  updatedAt   DateTime @updatedAt

  documents KycDocument[]

  @@index([status])
  @@index([userId])
}

model KycDocument {
  id                    String              @id @default(cuid())
  verificationRequestId String
  verificationRequest   VerificationRequest @relation(fields: [verificationRequestId], references: [id], onDelete: Cascade)

  documentType KycDocumentType
  fileName     String?
  originalName String?
  fileUrl      String
  fileSize     Int?
  mimeType     String?

  status          KycDocumentStatus @default(PENDING)
  rejectionReason String?
  reviewedById    String?
  reviewedAt      DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([verificationRequestId, documentType])
  @@index([status])
}

model ResumeParseResult {
  id              String        @id @default(cuid())
  workerProfileId String        @unique
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  rawText           String?
  parsedSkills      String[]
  yearsOfExperience Int?
  masteryLevel      String?
  tradeCategory     String?
  summary           String?

  parsedAt  DateTime @default(now())
  modelUsed String   @default("claude-sonnet-4-6")

  @@index([workerProfileId])
}

model Certification {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  title       String
  issuer      String
  issueDate   DateTime
  expiryDate  DateTime?
  documentUrl String

  // Verification tracking
  verificationStatus KycDocumentStatus @default(PENDING)
  rejectionReason    String?
  reviewedAt         DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerProfileId])
  @@index([verificationStatus])
}

model Skill {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  name     String
  category String
  rate     Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerProfileId])
}

// ============================================================================
// LEGAL
// ============================================================================

model ContractAcceptance {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  contractType    ContractType
  contractVersion String       @default("1.0")
  acceptedAt      DateTime     @default(now())
  ipAddress       String?
  userAgent       String?

  @@index([userId, contractType])
}

// ============================================================================
// SERVICES
// ============================================================================

model ServiceType {
  id          String  @id @default(cuid())
  name        String
  description String?
  basePrice   Float
  isActive    Boolean @default(true)

  // Admin-configured booking "scope" step for this category — see
  // ServiceScopeType/ServiceScopeField for the CUSTOM case.
  scopeType    ServiceScopeType @default(ROOM_BASED)
  hasCondition Boolean          @default(true)

  // Relations
  workers     WorkerProfile[]
  tasks       ServiceTask[]
  packages    WorkerPackage[]
  scopeFields ServiceScopeField[]

  @@unique([name])
}

// Admin-defined question shown in the booking "scope" step when the parent
// ServiceType.scopeType is CUSTOM (e.g. "Appliance Type" for Appliance
// Repair). Answers are snapshotted onto Booking.scopeAnswers keyed by
// `label`, not by this row's id, so editing/reordering fields later doesn't
// orphan past bookings.
model ServiceScopeField {
  id            String      @id @default(cuid())
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  label     String
  fieldType ScopeFieldType
  required  Boolean        @default(true)
  sortOrder Int            @default(0)

  options ServiceScopeFieldOption[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([serviceTypeId])
}

model ServiceScopeFieldOption {
  id      String            @id @default(cuid())
  fieldId String
  field   ServiceScopeField @relation(fields: [fieldId], references: [id], onDelete: Cascade)

  label     String
  sortOrder Int    @default(0)

  @@index([fieldId])
}

// A worker-defined, priced service bundle (e.g. "Deep Clean Package — ₱1500,
// includes fridge + oven + windows"), offered for one of the worker's own
// service categories. Replaces the old free/unpriced add-on toggles in the
// booking flow — see BookingAddOn for how a selected package is actually
// charged (resolved server-side to a priced add-on line item at booking
// creation, see bookingController.createBooking).
model WorkerPackage {
  id              String        @id @default(cuid())
  workerProfileId String
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)
  serviceTypeId   String
  serviceType     ServiceType   @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  name        String
  description String?
  price       Float
  isActive    Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([workerProfileId])
  @@index([serviceTypeId])
}

model ServiceTask {
  id            String      @id @default(cuid())
  serviceTypeId String
  serviceType   ServiceType @relation(fields: [serviceTypeId], references: [id], onDelete: Cascade)

  name          String
  description   String?
  basePrice     Float
  durationHours Float
  isActive      Boolean @default(true)

  // Relations
  bookings Booking[]

  @@index([serviceTypeId])
}

// ============================================================================
// BOOKINGS
// ============================================================================

model Booking {
  id String @id @default(cuid())

  // Parties — workerId is nullable to support open/unassigned marketplace
  // requests (web's behavior) that later get claimed or matched to a worker.
  clientId String
  client   User    @relation("client", fields: [clientId], references: [id], onDelete: Cascade)
  workerId String?
  worker   User?   @relation("worker", fields: [workerId], references: [id], onDelete: Cascade)

  // Auto-matching — set when the system assigned workerId rather than the
  // client picking a specific worker; declinedWorkerIds is the running
  // denormalized skip-list consulted on each match attempt (see DeclinedWorker
  // for the audited, per-attempt companion record).
  isAutoMatched     Boolean   @default(false)
  declinedWorkerIds String[]
  expiresAt         DateTime?

  // Service
  serviceType            String
  serviceTaskId          String?
  serviceTask            ServiceTask?   @relation(fields: [serviceTaskId], references: [id])
  description            String
  estimatedDurationHours Float?
  rooms                  RoomType[]
  condition              ConditionType?
  priorities             String[]
  addOnsSnapshot         Json? // itemized add-ons as submitted at booking time; BookingAddOn[] below is the normalized/authoritative record
  scopeAnswers           Json? // { [ServiceScopeField.label]: string | string[] } snapshot for CUSTOM-scope services (see ServiceType.scopeType)
  issuePhotoUrls         String[]       @default([]) // client-attached photos of the issue, uploaded at Step 1 before the booking exists (see POST /bookings/issue-photo/upload)

  // Scheduling
  scheduledDate  DateTime
  scheduledTime  String?
  timeSlot       TimeSlot?
  urgencyLevel   UrgencyLevel @default(STANDARD)
  completionDate DateTime?

  // Status
  status BookingStatus @default(PENDING)

  // Pricing — initial estimate
  estimatedPrice Float
  tip            Float? @default(0)

  // Quote lifecycle
  quoteStatus   QuoteStatus?
  laborCost     Float?
  materialsCost Float?
  quotedAt      DateTime?
  quoteNotes    String?
  approvedAt    DateTime?
  disputeReason String?

  // Dispute resolution audit — who (admin userId, no FK to keep this a soft
  // reference like VerificationRequest.reviewedById) resolved it and when.
  disputeResolvedById String?
  disputeResolvedAt   DateTime?

  // Inspection fee
  inspectionFeeCharged Boolean @default(false)
  inspectionFeeAmount  Float?

  // Final
  finalPrice Float?

  // Completion — worker-submitted proof photo, awaiting client confirmation
  completionPhotoUrl String?

  // Job execution timeline — discrete milestones distinct from completionDate
  // (client-confirmed) and workerArrivedAt (see ArrivalVerification for the
  // audited GPS check-in event this timestamp mirrors).
  workerArrivedAt   DateTime?
  workerStartedAt   DateTime?
  workerCompletedAt DateTime?

  // Payment method chosen by the client at booking time — settled upfront so
  // the client isn't asked to pick a method again after confirming completion.
  paymentMethodType        PaymentMethodType?
  paymentAccountIdentifier String?

  // Location
  location String
  city     String
  notes    String?

  // GPS snapshots — client location at booking time, worker's last known
  // position, and the derived distance between them (meters).
  clientLat      Float?
  clientLng      Float?
  workerLat      Float?
  workerLng      Float?
  distanceMeters Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  payment             Payment?
  review              Review?
  addOns              BookingAddOn[]
  declinedWorkers     DeclinedWorker[]
  arrivalVerification ArrivalVerification?
  cancellation        Cancellation?
  pricingLogs         PricingLog[]
  disputes            Dispute[]

  // NOTE: only enforceable while workerId is set — see merge notes.
  @@unique([workerId, scheduledDate, timeSlot], name: "worker_slot_unique")
  @@index([clientId, status])
  @@index([workerId, status])
  @@index([scheduledDate])
  @@index([status])
}

model BookingAddOn {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  name  String
  price Float

  @@index([bookingId])
}

// ============================================================================
// BOOKING FLOW — MATCHING, ARRIVAL, CANCELLATION, PRICING, DISPUTES
// Worker/actor references below are intentionally soft (plain String id, no
// FK) to match the existing audit-style convention already used elsewhere
// (AuditLog.actorId, VerificationRequest.reviewedById, Booking.disputeResolvedById).
// ============================================================================

// Per-attempt audit trail for auto-matching skip logic — Booking.declinedWorkerIds
// is the fast denormalized read; this is the "why/when" companion.
model DeclinedWorker {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  workerId String // soft reference — worker who declined or was skipped
  reason   String?

  declinedAt DateTime @default(now())

  @@unique([bookingId, workerId])
}

// GPS check-in event recorded when a worker marks themselves as arrived at
// the job site — the immutable audit record; Booking.workerLat/workerLng
// hold the live/last-known position.
model ArrivalVerification {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  workerLat      Float
  workerLng      Float
  distanceMeters Float
  isVerified     Boolean @default(false) // within the accepted geofence radius

  createdAt DateTime @default(now())
}

model Cancellation {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  cancelledBy   Role // CLIENT, WORKER, or ADMIN
  cancelledById String // soft reference to the user who cancelled
  reason        String?

  feeCharged   Float? @default(0)
  refundAmount Float?

  createdAt DateTime @default(now())
}

// Itemized pricing snapshot — logged whenever the estimate is (re)computed,
// e.g. on initial submit and again after condition/distance are known.
model PricingLog {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  basePrice     Float
  conditionFee  Float? @default(0)
  distanceFee   Float? @default(0)
  urgencyFee    Float? @default(0)
  tierFee       Float? @default(0)
  addOnsTotal   Float? @default(0)
  finalEstimate Float
  breakdown     Json? // full itemized snapshot for support/audit lookups

  createdAt DateTime @default(now())

  @@index([bookingId])
}

model Dispute {
  id        String  @id @default(cuid())
  bookingId String
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  raisedById   String // soft reference — client or worker who raised it
  reason       String
  evidenceUrls String[]

  status       String    @default("OPEN") // 'OPEN' | 'UNDER_REVIEW' | 'RESOLVED' | 'REJECTED'
  resolution   String?
  resolvedById String? // soft reference — admin who resolved it
  resolvedAt   DateTime?
  refundAmount Float?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
}

// ============================================================================
// PAYMENTS
// ============================================================================

model Payment {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  // Amounts
  subtotal Float
  tip      Float @default(0)

  // Commission
  commissionRate   Float @default(0.10)
  commissionAmount Float

  // Withholding tax (BIR compliance for professional fees)
  withholdingTaxRate   Float @default(0.05)
  withholdingTaxAmount Float

  // Worker receives
  workerPayout Float

  // Total charged to client
  totalAmount Float

  // Status
  status       PaymentStatus @default(PENDING)
  escrowStatus EscrowStatus  @default(HELD)
  releasedAt   DateTime?

  // Refund audit
  refundReason String?
  refundedAt   DateTime?

  // Set when status becomes FAILED — raw reason from PayMongo's webhook
  // payload (translated for end users via utils/paymongoFailureMessages.ts).
  failureReason String?

  // PayMongo references
  paymongoPaymentId String?
  paymongoSourceId  String?

  // Authorize/capture flow — amount is held (authorized) at booking time and
  // captured on completion; capturedAmount may differ from authorizedAmount
  // if the final price changed (e.g. quote approval, add-ons).
  authorizedAmount Float?
  authorizedAt     DateTime?
  capturedAmount   Float?
  capturedAt       DateTime?
  // Deprecated — populated only on CARD-era rows from before CARD support
  // was removed; no longer written to.
  authorizationId  String?
  paymentIntentId  String?
  clientSecret     String?

  // Payment method used
  methodType        PaymentMethodType
  accountIdentifier String? // masked GCash/Maya number, etc.

  payout Payout?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([status])
  @@index([escrowStatus])
}

// Tracks the actual disbursement of a worker's payout via PayMongo, separate
// from Payment.escrowStatus (which only tracks the platform's own escrow
// ledger — RELEASED means "the worker's cut is owed", not "the worker has
// been paid"). One Payout per Payment, created once escrow is released.
model Payout {
  id        String  @id @default(cuid())
  paymentId String  @unique
  payment   Payment @relation(fields: [paymentId], references: [id], onDelete: Cascade)
  bookingId String // denormalized for cheap admin filtering, soft reference like Dispute.raisedById
  workerId  String // soft reference — User.id of the worker being paid

  amount        Float
  channel       PaymentMethodType // GCASH/MAYA — CASH is not a valid payout channel
  accountName   String? // snapshot of WorkerProfile.payoutAccountName at send time
  accountNumber String // snapshot of WorkerProfile.payoutAccountNumber at send time

  status                PayoutStatus @default(PENDING)
  paymongoTransferId    String?      @unique
  paymongoTransferStatus String? // raw status string from PayMongo, for debugging
  // Deprecated — populated only on Xendit-era rows from before the PayMongo
  // disbursement migration; no longer written to.
  xenditDisbursementId  String?      @unique
  xenditStatus          String?
  failureReason         String?
  attempts              Int          @default(0)

  processingAt DateTime?
  paidAt       DateTime?
  failedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([bookingId])
  @@index([workerId])
  @@index([status])
}

// Prepaid balance a worker maintains to cover the per-job admin fee deducted
// at booking acceptance (see bookingController.acceptBooking) — distinct
// from Payout, which is the platform paying the worker their job earnings.
model WorkerWallet {
  id              String        @id @default(cuid())
  workerProfileId String        @unique
  workerProfile   WorkerProfile @relation(fields: [workerProfileId], references: [id], onDelete: Cascade)

  balance Float @default(0)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  transactions WalletTransaction[]
}

enum WalletTransactionType {
  TOPUP
  ADMIN_FEE_DEDUCTION
  REFUND
  ADMIN_ADJUSTMENT
}

enum WalletTransactionStatus {
  PENDING
  COMPLETED
  FAILED
}

model WalletTransaction {
  id       String       @id @default(cuid())
  walletId String
  wallet   WorkerWallet @relation(fields: [walletId], references: [id], onDelete: Cascade)

  type   WalletTransactionType
  status WalletTransactionStatus @default(PENDING)

  // Signed: credits (TOPUP, REFUND, positive ADMIN_ADJUSTMENT) are positive,
  // debits (ADMIN_FEE_DEDUCTION, negative ADMIN_ADJUSTMENT) are negative.
  amount       Float
  balanceAfter Float?

  bookingId          String? // soft reference — links a deduction/refund to the job it was for
  paymongoCheckoutId String? @unique // set for TOPUP rows, keys the webhook back to this transaction
  failureReason      String?
  note               String? // admin's reason, for ADMIN_ADJUSTMENT rows

  createdAt DateTime @default(now())

  @@index([walletId])
  @@index([bookingId])
}

model SavedPaymentMethod {
  id              String        @id @default(cuid())
  clientProfileId String
  clientProfile   ClientProfile @relation(fields: [clientProfileId], references: [id], onDelete: Cascade)

  type              PaymentMethodType
  accountIdentifier String? // masked — last 4 digits or masked phone number
  label             String? // e.g. "My GCash", "Work Card"
  isDefault         Boolean           @default(false)

  createdAt DateTime @default(now())

  @@index([clientProfileId])
}

// ============================================================================
// REVIEWS
// ============================================================================

model Review {
  id        String  @id @default(cuid())
  bookingId String  @unique
  booking   Booking @relation(fields: [bookingId], references: [id], onDelete: Cascade)

  workerId String
  worker   WorkerProfile @relation(fields: [workerId], references: [id], onDelete: Cascade)

  clientId String
  client   User   @relation(fields: [clientId], references: [id], onDelete: Cascade)

  rating    Float // 1.0 to 5.0
  comment   String?
  photoUrls String[] @default([]) // client-attached photos, uploaded via POST /bookings/:id/review-photo/upload

  // Moderation — admin-side flagging/hiding, see ReviewStatus
  flagged    Boolean      @default(false)
  flagReason String?
  status     ReviewStatus @default(VISIBLE)

  createdAt DateTime @default(now())

  @@index([workerId])
  @@index([clientId])
  @@index([flagged])
}

enum ReviewStatus {
  VISIBLE
  HIDDEN
  WARNED
}

// ============================================================================
// MESSAGING
// ============================================================================

model Message {
  id         String @id @default(cuid())
  senderId   String
  sender     User   @relation("sender", fields: [senderId], references: [id], onDelete: Cascade)
  receiverId String
  receiver   User   @relation("receiver", fields: [receiverId], references: [id], onDelete: Cascade)

  content  String
  imageUrl String?
  isRead   Boolean   @default(false)
  readAt   DateTime?

  createdAt DateTime @default(now())

  @@index([senderId])
  @@index([receiverId])
  @@index([createdAt])
}

// ============================================================================
// NOTIFICATIONS
// ============================================================================

model Notification {
  id     String @id @default(cuid())
  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  type      NotificationType
  title     String
  message   String
  relatedId String?
  isRead    Boolean          @default(false)

  createdAt DateTime @default(now())

  @@index([userId])
  @@index([isRead])
  @@index([userId, isRead])
}

// ============================================================================
// ADMIN — AUDIT LOG, PRICING RULES, SETTINGS
// ============================================================================

model AuditLog {
  id        String  @id @default(cuid())
  actorId   String?
  actorName String?
  actorRole String?

  action   String // e.g. 'USER_LOGIN_SUCCESS', 'BOOKING_DECLINED', 'DISPUTE_RESOLVED'
  category String // 'ADMIN_ACTION' | 'LOGIN' | 'SYSTEM_ERROR' | 'STATUS_CHANGE'
  level    String @default("INFO") // 'INFO' | 'WARN' | 'ERROR'
  message  String
  metadata Json?

  createdAt DateTime @default(now())

  @@index([category])
  @@index([createdAt])
  @@index([actorId])
}

model PricingRule {
  id          String @id @default(cuid())
  city        String
  serviceType String
  minPrice    Float
  maxPrice    Float

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([city, serviceType])
}

model AppSettings {
  id                   String  @id @default("singleton")
  siteName             String  @default("HomeEaseAdmin")
  supportEmail         String  @default("support@homeease.dev")
  notificationsEnabled Boolean @default(true)

  // Platform configuration — live business rules read at runtime by the
  // booking/payment/worker-availability flows (see appSettingsService).
  commissionRate       Float @default(0.10)
  withholdingTaxRate   Float @default(0.05)
  maxSlotsPerDay       Int   @default(2)
  pendingExpiryMinutes Int   @default(60)
  geofenceRadiusMeters Int   @default(100)

  // Worker decline-limit cooldown (see bookingController.declineBooking) —
  // hit maxDeclinesBeforeCooldown declines within declineWindowHours and the
  // worker is excluded from auto-match for declineCooldownHours.
  maxDeclinesBeforeCooldown Int @default(3)
  declineWindowHours        Int @default(168) // 7 days
  declineCooldownHours      Int @default(24)

  // Expertise-tier pricing (see utils/workerTier.ts) — tier is computed on
  // the fly from WorkerProfile.rating + completed-job count, not stored;
  // these thresholds/multipliers are the only admin-configurable part.
  tierProMinRating    Float @default(4.5)
  tierProMinJobs      Int   @default(20)
  tierProMultiplier   Float @default(1.15)
  tierExpertMinRating Float @default(4.8)
  tierExpertMinJobs   Int   @default(50)
  tierExpertMultiplier Float @default(1.3)

  // Prepaid wallet admin-fee gate (see walletService.ts, bookingController.acceptBooking)
  // — flat fee in pesos, independent of job price so it isn't affected by
  // later quote/add-on changes.
  adminFeePerJob Float @default(20)

  updatedAt DateTime @updatedAt
}
