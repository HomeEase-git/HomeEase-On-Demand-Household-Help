# Server
PORT=
NODE_ENV=
APP_URL=

# Database
DATABASE_URL=

# Neon
DATABASE_URL=
DIRECT_URL=

# JWT
JWT_SECRET=
JWT_EXPIRY=

# Email — Resend
RESEND_API_KEY=
RESEND_FROM_EMAIL=

# Payments — PayMongo (Philippines)
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
# PayMongo rejects non-http(s) redirect URLs (e.g. custom app schemes), so
# Source checkout redirects go to this placeholder domain first — the mobile
# WebView intercepts navigation to it before it ever actually loads. Must
# match PaymongoCheckoutModal.tsx's REDIRECT_SUCCESS_PREFIX/REDIRECT_FAILED_PREFIX.
PAYMONGO_REDIRECT_BASE_URL=

# Worker payouts — PayMongo Disbursements (Wallet -> InstaPay/PESONet). Same
# PAYMONGO_SECRET_KEY above also authorizes these; the Wallet must be enabled
# for disbursements (not closed-loop) on your PayMongo account. accountNumber/
# accountName identify the PayMongo Wallet the transfers are sent from.
PAYMONGO_WALLET_ACCOUNT_NUMBER=
PAYMONGO_WALLET_ACCOUNT_NAME=

# SMS OTP — Semaphore PH
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=

# Redis (required for AI verification queue)
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# File Storage — Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_KYC_BUCKET=
SUPABASE_RESUME_BUCKET=
SUPABASE_CHAT_BUCKET=

# AI Resume Parsing — Claude API
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# File Upload
MAX_FILE_SIZE=
UPLOAD_DIR=

# CORS
ALLOWED_ORIGINS=

# Commission & withholding tax rate DEFAULTS ONLY — the live, admin-editable
# values actually used at runtime are the AppSettings DB row (see Settings in
# the admin dashboard); these env vars are just the fallback if that row is
# ever missing. Names must match what backend/src/config/pricing.ts reads.
COMMISSION_RATE=
WITHHOLDING_TAX_RATE=

MAYA_PUBLIC_KEY=your_sandbox_public_key
MAYA_SECRET_KEY=your_sandbox_secret_key