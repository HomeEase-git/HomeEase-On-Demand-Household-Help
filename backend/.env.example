# Server
PORT=
NODE_ENV=
APP_URL=

# Database — Neon. DATABASE_URL is the pooled connection (runtime queries),
# DIRECT_URL is unpooled (Prisma migrations need this one).
DATABASE_URL=
DIRECT_URL=

# Neon API key (console.neon.tech -> Account/Org Settings -> API Keys) —
# only needed to use `npm run neon:branch` (scripts/neon-branch.ts), which
# creates/switches an isolated per-session Neon branch and points
# DATABASE_URL/DIRECT_URL above at it, instead of everyone hitting the one
# shared "production" branch directly.
NEON_API_KEY=

# JWT
JWT_SECRET=
# Plain seconds, NOT a duration string — src/utils/jwt.ts does
# Number.parseInt() on this itself, so "1h"/"7d" silently becomes 1.
# e.g. 604800 = 7 days, 3600 = 1 hour.
JWT_EXPIRY=

# Email — pluggable transport. EMAIL_PROVIDER = smtp (default) | gmail-api | brevo.
# All three send FROM: "${EMAIL_FROM_NAME} <${EMAIL_FROM_ADDRESS}>"
# (EMAIL_FROM_ADDRESS falls back to SMTP_USER / GMAIL_SENDER / BREVO_SENDER_EMAIL).
EMAIL_PROVIDER=smtp
EMAIL_FROM_NAME=HomeEase
EMAIL_FROM_ADDRESS=

# --- smtp ---
# SMTP_USER: the project Gmail address (also where replies are received).
# SMTP_PASS: a 16-char Google "App Password" — NOT the account password.
#   Generate at: Google Account -> Security -> 2-Step Verification -> App passwords
# SMTP_HOST/PORT/SECURE are optional (default smtp.gmail.com : 465 : true).
#   Try SMTP_PORT=587 + SMTP_SECURE=false if 465 is blocked by the host.
# SMTP_FAMILY: IP family for the SMTP socket. Defaults to 4 — hosted envs
#   (e.g. Render) often resolve smtp.gmail.com to IPv6 with no IPv6 route,
#   and nodemailer won't fall back. Set 0 for "try both", 6 to force IPv6.
SMTP_USER=
SMTP_PASS=
SMTP_FROM_NAME=HomeEase
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_SECURE=true
SMTP_FAMILY=4

# --- gmail-api (Gmail REST API over HTTPS — no SMTP port needed) ---
# OAuth2 client from Google Cloud Console with the Gmail API enabled; the
# refresh token is minted once against scope https://www.googleapis.com/auth/gmail.send
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=

# --- brevo (HTTP API; "single sender" verification allows a Gmail address) ---
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=HomeEase

# Set to "true" only while validating an email provider — enables
# POST /internal/diag/email-test (auth: x-cron-secret: $CRON_SECRET).
ENABLE_EMAIL_DIAG=

# Payments — Xendit (Philippines). Same XENDIT_SECRET_KEY authorizes both
# the collection leg (Invoices, xenditService.ts) and the disbursement leg
# (Payouts, xenditDisbursementService.ts) — no separate wallet account
# number/name is needed, Xendit payouts draw from the account balance
# directly.
XENDIT_SECRET_KEY=
# Static token Xendit sends via the x-callback-token header on every
# webhook (configured in the Xendit dashboard's Webhooks settings) —
# direct-compared (crypto.timingSafeEqual), not an HMAC like PayMongo used.
XENDIT_WEBHOOK_TOKEN=
# Xendit rejects non-http(s) redirect URLs (e.g. custom app schemes), so
# Invoice checkout redirects go to this placeholder domain first — the
# mobile WebView intercepts navigation to it before it ever actually loads.
# Must match XenditCheckoutModal.tsx's
# REDIRECT_SUCCESS_PREFIX/REDIRECT_FAILED_PREFIX.
XENDIT_REDIRECT_BASE_URL=

# SMS — PhilSMS (https://app.philsms.com). API token from Account > API
# Documents. Sender ID is the alphanumeric "from" name shown on the
# recipient's phone (max 11 chars) — must be registered/approved in the
# PhilSMS dashboard before use.
PHILSMS_API_TOKEN=
PHILSMS_SENDER_ID=

# Redis — required for BullMQ (payouts, booking-lifecycle timeouts,
# verification AI queue). Two ways to configure, pick one:
#   REDIS_URL         a single connection string (redis:// or rediss:// for
#                      TLS) — what most managed Redis hands you (Render Key
#                      Value, Upstash, Railway). Takes priority if set.
#   REDIS_HOST/PORT/PASSWORD  separate fields — what local dev and
#                      docker-compose use.
REDIS_URL=
REDIS_HOST=
REDIS_PORT=
REDIS_PASSWORD=

# File Storage — Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_KEY=
SUPABASE_KYC_BUCKET=
SUPABASE_RESUME_BUCKET=
SUPABASE_CHAT_BUCKET=
# Private bucket (worker TINs + income figures) — served via signed URLs only.
SUPABASE_TAX_CERTIFICATE_BUCKET=

# Claude API — powers resume parsing AND the KYC verification document review
# (verificationAiService). Without ANTHROPIC_API_KEY the verification review
# degrades to a non-AI heuristic file-listing (aiStatus HEURISTIC_REVIEWED) and
# resume parsing is skipped. The review reads image (JPG/PNG/WEBP) and PDF
# documents; other types are listed but not assessed.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

# File Upload — max bytes per uploaded file (default 5 MB). This is the cap on
# the ORIGINAL upload; KYC/verification images are then downscaled + re-encoded
# to JPEG server-side (sharp / normalizeImage) before storage.
MAX_FILE_SIZE=
UPLOAD_DIR=

# CORS
ALLOWED_ORIGINS=

# Commission & withholding tax rate DEFAULTS ONLY — the live, admin-editable
# values actually used at runtime are the AppSettings DB row (see Settings in
# the admin dashboard); these env vars are just the fallback if that row is
# ever missing. Names must match what backend/src/config/pricing.ts reads.
COMMISSION_RATE=
WITHHOLDING_TAX_RATE=

# Withholding-agent identity printed on generated BIR Form 2307 certificates
# (see taxCertificateService.ts). Static business facts, not admin-editable
# settings — unlike commission/tax rate, these don't need a DB row.
PLATFORM_LEGAL_NAME=
PLATFORM_TIN=

# ---------------------------------------------------------------------------
# Deployment / runtime hardening (all optional — safe defaults shown)
# ---------------------------------------------------------------------------

# Shared secret for POST /internal/cron/:task (x-cron-secret header) — the
# hourly GitHub Actions sweep that keeps booking-lifecycle timeouts working
# on hosts that sleep the in-process BullMQ worker on idle (e.g. Render's
# free tier). Required for that route to accept any request at all — unset
# fails closed. Generate a long random value, e.g. `openssl rand -hex 32`.
CRON_SECRET=

# Number of reverse-proxy hops in front of the app (Express `trust proxy`).
# 0 = the app is hit directly. Behind one nginx / load balancer / PaaS
# router, set 1 — the rate limiter keys on client IP and needs this right.
TRUST_PROXY=0

# Max JSON / urlencoded request body. Default 1mb.
JSON_BODY_LIMIT=1mb

# Graceful-shutdown drain budget (ms) on SIGTERM/SIGINT before the process
# is force-killed. Keep below the platform's own kill grace period.
SHUTDOWN_TIMEOUT_MS=15000

# Set false to skip `prisma migrate deploy` in the Docker entrypoint (run
# migrations as a separate release step instead).
RUN_MIGRATIONS=true

# Rate limiting. RATE_LIMIT_DISABLED=true turns both limiters off. API =
# broad limiter over all /api routes; AUTH = strict limiter on login /
# signup / OTP / password-reset (counts failed attempts only).
RATE_LIMIT_DISABLED=false
RATE_LIMIT_API_WINDOW_MS=60000
RATE_LIMIT_API_MAX=300
RATE_LIMIT_AUTH_WINDOW_MS=900000
RATE_LIMIT_AUTH_MAX=10