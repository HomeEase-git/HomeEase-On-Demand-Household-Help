# Files that MUST stay LF in the working tree — CRLF breaks them inside
# containers (shebang, nginx include parsing, Docker COPY of scripts).
*.sh                 text eol=lf
docker-entrypoint.sh text eol=lf
Dockerfile           text eol=lf
*.dockerfile         text eol=lf
*.template           text eol=lf
docker-compose*.yml  text eol=lf
