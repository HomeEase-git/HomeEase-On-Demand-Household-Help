# ==============================
# Environment variables / secrets
# ==============================
.env
.env.*
!.env.example
!.env.sample
**/.env
**/.env.*
!**/.env.example
!**/.env.sample

# ==============================
# Credentials, keys & certificates
# ==============================
**/*serviceAccount*.json
**/*service-account*.json
**/google-services.json
# google-services.json is not a secret (it ships inside the public APK anyway,
# and its API key is restricted server-side to this package name + signing
# cert) — EAS Build needs it committed to include it in the build archive.
!mobile/google-services.json
*firebase-adminsdk*.json
**/GoogleService-Info.plist
**/*.pem
**/*.key
**/*.p12
**/*.p8
**/*.pfx
**/*.jks
**/*.keystore
**/*credentials*.json
**/*secrets*.json
**/id_rsa
**/id_rsa.pub

# ==============================
# Dependencies
# ==============================
node_modules/
**/node_modules/

# ==============================
# Build output
# ==============================
backend/dist/
web/dist/
**/dist/
**/build/

# ==============================
# Mobile / Expo / React Native
# ==============================
mobile/.expo/
**/.expo/
**/.expo-shared/
mobile/android/
mobile/ios/
*.log
**/*.log
*.orig.*

