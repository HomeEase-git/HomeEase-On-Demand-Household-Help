# Backend API base URL — point this at your machine's LAN IP (not localhost)
# so the Expo Go app on a physical device/simulator can reach it.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Google Maps JavaScript API key for rendering the in-app map (WebView-hosted
# — see components/ui/GoogleMap.tsx). This is a DIFFERENT key from the
# backend's GOOGLE_MAPS_API_KEY: it ships inside the app bundle, so in the
# Cloud Console restrict it via "API restrictions" to ONLY the "Maps
# JavaScript API" (do not enable Geocoding/Distance Matrix/Directions on this
# key — those stay server-side-only on the backend's key). Leave unset during
# development and the map will show a placeholder instead of loading broken.
EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
