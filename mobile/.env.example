# Backend API base URL — point this at your machine's LAN IP (not localhost)
# so the Expo Go app on a physical device/simulator can reach it.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000

# Maps SDK for Android key for the in-app map (react-native-maps — see
# components/ui/GoogleMap.tsx and app.config.ts). Read at BUILD time, not
# runtime, so it only matters for local `npx expo run:android` builds; EAS
# builds take it from the GOOGLE_MAPS_ANDROID_API_KEY environment variable on
# expo.dev instead. This is a DIFFERENT key from the backend's
# GOOGLE_MAPS_API_KEY: in the Cloud Console restrict it to Android apps
# (package com.homeease.app + the signing SHA-1) and to ONLY "Maps SDK for
# Android". Leave unset and the map shows a placeholder instead of crashing.
GOOGLE_MAPS_ANDROID_API_KEY=
