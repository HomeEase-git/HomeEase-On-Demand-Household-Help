# Optional overrides for docker-compose.yml. Compose reads this file
# automatically. Every value has a default baked into docker-compose.yml, so
# you only need this file to change ports or the local DB password.
#
# Application secrets do NOT go here — they live in backend/.env
# (see backend/.env.example).

# Local Postgres (the containerised one, not Neon)
POSTGRES_USER=homeease
POSTGRES_PASSWORD=homeease
POSTGRES_DB=homeease

# Host ports
WEB_PORT=8080
BACKEND_PORT=3000
POSTGRES_PORT=5432

# Public URL the admin web is served from, and the CORS allow-list the API
# honours. Set both to your real domain in a real deploy.
APP_URL=http://localhost:8080
ALLOWED_ORIGINS=http://localhost:8080
